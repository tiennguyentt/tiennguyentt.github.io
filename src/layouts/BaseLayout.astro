---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { withBase } from '../lib/url';
import { NAV_ITEMS, RESUME_PAGE, SITE } from '../consts';
import { locale, navLabel, t } from '../i18n';
import CodeCopy from '../components/CodeCopy.astro';
import SocialLinks from '../components/SocialLinks.astro';
import BrandLogo from '../components/BrandLogo.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  image?: string;
}

const siteName = SITE.title;

const { title = siteName, description = SITE.description, ogType = 'website', image } = Astro.props;

const siteBase = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const imageURL = image ? new URL(image, siteBase) : new URL(withBase(SITE.ogImage), siteBase);
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  const full = withBase(href);
  return href === '/' ? currentPath === full : currentPath.startsWith(full);
};
---

<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#F5F2EA" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase('/favicon-16.png')} />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={siteName} href={withBase('/rss.xml')} />
    <title>{fullTitle}</title>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={locale.replace('-', '_')} />
    {imageURL && <meta property="og:image" content={imageURL} />}

    <meta name="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}
    <slot name="head" />
    <ClientRouter />
    <script is:inline>
      (() => {
        document.documentElement.dataset.theme = 'light';
        localStorage.setItem('theme', 'light');
        document.addEventListener('astro:after-swap', () => {
          document.documentElement.dataset.theme = 'light';
        });
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href={withBase('/')} aria-label={t('nav.brandHome', { site: siteName })}>
          <BrandLogo />
          <span class="visually-hidden">{siteName}</span>
        </a>
        <button class="nav-toggle" type="button" aria-controls="site-nav" aria-expanded="false">
          <span class="nav-toggle__icon" aria-hidden="true"></span>
          Menu
        </button>
        <nav class="site-nav" id="site-nav" aria-label={t('nav.label')}>
          {
            NAV_ITEMS.map((item) => (
              <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {navLabel(item)}
              </a>
            ))
          }
          <a
            class="site-nav__resume"
            href={withBase(RESUME_PAGE)}
            aria-current={isActive(RESUME_PAGE) ? 'page' : undefined}>Resume</a
          >
        </nav>
        <a
          class="header-cta"
          href={withBase(RESUME_PAGE)}
          aria-current={isActive(RESUME_PAGE) ? 'page' : undefined}>Resume</a
        >
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>{SITE.footerText}</p>
      <div class="footer-links">
        <a href={withBase('/works/')}>Work</a>
        <a href={withBase('/about/')}>About</a>
        <a href="mailto:tiennguyentthao@gmail.com">Email</a>
      </div>
      <SocialLinks />
    </footer>

    <CodeCopy />
    <script>
      const closeMenu = (restoreFocus = false) => {
        const header = document.querySelector<HTMLElement>('.site-header');
        const toggle = header?.querySelector<HTMLButtonElement>('.nav-toggle');
        if (!header || !toggle || toggle.getAttribute('aria-expanded') !== 'true') return;
        toggle.setAttribute('aria-expanded', 'false');
        header.classList.remove('site-header--menu-open');
        if (restoreFocus) toggle.focus();
      };

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const toggle = target.closest<HTMLButtonElement>('.nav-toggle');
        if (toggle) {
          const expanded = toggle.getAttribute('aria-expanded') === 'true';
          toggle.setAttribute('aria-expanded', String(!expanded));
          toggle.closest('.site-header')?.classList.toggle('site-header--menu-open', !expanded);
          return;
        }
        if (target.closest('.site-nav a') || !target.closest('.site-header')) closeMenu();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeMenu(true);
      });

      window.addEventListener('resize', () => {
        if (window.innerWidth > 760) closeMenu();
      });

      document.addEventListener('astro:after-swap', () => closeMenu());
    </script>
  </body>
</html>
