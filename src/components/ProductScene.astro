---
import GelatoControlPlane from './GelatoControlPlane.astro';

interface Props {
  kind: 'knowledge' | 'sport' | 'recon' | 'gelato';
}

const { kind } = Astro.props;
---

{
  kind === 'knowledge' && (
    <div class="scene scene--knowledge" aria-hidden="true">
      <p class="scene-kicker">Source-linked requirements</p>
      <p class="scene-lead">From meeting notes to a reviewed spec</p>
      <ol class="scene-flow">
        <li>
          <span>01</span>Meeting transcript
        </li>
        <li>
          <span>02</span>Wiki linked to sources
        </li>
        <li>
          <span>03</span>Human sign-off
        </li>
      </ol>
    </div>
  )
}

{
  kind === 'sport' && (
    <div class="scene scene--sport" aria-hidden="true">
      <p class="scene-kicker">Prediction-market research</p>
      <p class="scene-measure">
        1% <span>exposure cap</span>
      </p>
      <p class="scene-note">
        Elo and Dixon-Coles estimates. Fractional Kelly sizing. The cap runs in code.
      </p>
    </div>
  )
}

{
  kind === 'recon' && (
    <div class="scene scene--recon" aria-hidden="true">
      <p class="scene-kicker">Daily research report</p>
      <p class="scene-lead">Each item gets three checks</p>
      <ul class="scene-checks">
        <li>Relevance</li>
        <li>Source credibility</li>
        <li>Predictive weight</li>
      </ul>
    </div>
  )
}

{kind === 'gelato' && <GelatoControlPlane />}

<style>
  .scene {
    display: flex;
    min-height: 11rem;
    height: 100%;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    color: var(--color-text);
    background: var(--color-paper);
  }

  .scene--knowledge {
    background: var(--color-ink);
    color: var(--color-surface);
  }

  .scene--sport {
    background: var(--color-surface);
  }

  .scene--recon {
    background: var(--color-paper);
  }

  .scene-kicker {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.35;
    text-transform: uppercase;
    opacity: 0.72;
  }

  .scene-lead {
    max-width: 20ch;
    margin: 0;
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.12;
  }

  .scene-flow,
  .scene-checks {
    display: grid;
    gap: 0;
    margin: auto 0 0;
    padding: 0;
    list-style: none;
  }

  .scene-flow li,
  .scene-checks li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    border-top: 1px solid currentColor;
    font-size: 0.9rem;
    line-height: 1.3;
  }

  .scene-flow li {
    border-color: var(--line-glass-control);
  }

  .scene-flow span {
    color: var(--color-signal);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .scene-checks li {
    border-color: var(--color-line);
  }

  .scene-checks li::before {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-signal);
    content: '';
  }

  .scene-measure {
    display: grid;
    gap: 0.25rem;
    margin: auto 0 0;
    font-size: clamp(3.5rem, 8vw, 5rem);
    font-weight: 600;
    letter-spacing: -0.07em;
    line-height: 0.95;
  }

  .scene-measure span {
    color: var(--color-muted);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .scene-note {
    max-width: 34ch;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.84rem;
    line-height: 1.45;
  }
</style>
