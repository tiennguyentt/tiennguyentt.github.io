---
interface Props {
  kind: 'knowledge' | 'sport' | 'recon' | 'gelato';
}

const { kind } = Astro.props;
---

{
  kind === 'knowledge' && (
    <div class="scene scene--chat">
      <p class="scene-bubble scene-bubble--in">Trace every claim to a source.</p>
      <p class="scene-bubble scene-bubble--out">Conflicts resolved. Spec graded.</p>
      <p class="scene-bubble scene-bubble--in">Human sign-off before engineering.</p>
    </div>
  )
}

{
  kind === 'sport' && (
    <div class="scene scene--build" aria-hidden="true">
      <div class="scene-chrome">
        <span />
        <span />
        <span />
        sport-quant
      </div>
      <pre class="scene-code">
        <span class="c-dim"># size the edge</span>
        <span>
          <span class="c-key">edge</span> = elo - market
        </span>
        <span>
          <span class="c-key">size</span> = kelly(edge) * 0.25
        </span>
        <span>
          <span class="c-warn">if</span> size &gt; 0.01: size = 0.01
        </span>
        <span class="c-ok">code.decide(size)</span>
      </pre>
    </div>
  )
}

{
  kind === 'recon' && (
    <div class="scene scene--bot">
      <p class="scene-bubble scene-bubble--out">Score relevance, credibility, weight.</p>
      <p class="scene-meta">Daily sweep · 3 scores · outcomes feed the weights</p>
      <p class="scene-status">
        <span class="scene-dot" />
        Scoring
      </p>
    </div>
  )
}

{
  kind === 'gelato' && (
    <div class="scene scene--voice">
      <div class="scene-orb" />
    </div>
  )
}

<style>
  .scene {
    height: 100%;
    min-height: 13.5rem;
    padding: 1.15rem 1.2rem 3.4rem;
  }

  .scene--chat,
  .scene--bot {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    background: #f4f4f2;
  }

  .scene-bubble {
    max-width: 88%;
    margin: 0;
    padding: 0.55rem 0.75rem;
    border-radius: 1rem;
    font-size: 0.78rem;
    line-height: 1.35;
    color: #2a2a2a;
    background: #fff;
  }

  .scene-bubble--out {
    align-self: flex-end;
    background: #ecece8;
  }

  .scene-meta {
    margin: 0.15rem 0 0;
    color: #6a6a6a;
    font-size: 0.72rem;
  }

  .scene-status {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    color: #6a6a6a;
    font-size: 0.75rem;
  }

  .scene-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #e31937;
    animation: scene-pulse 1.8s ease-in-out infinite;
  }

  .scene--build {
    padding: 0;
    background: #171717;
    color: #d7d7d4;
    font-family: var(--font-mono);
  }

  .scene-chrome {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.65rem 0.85rem;
    color: #8a8a86;
    font-size: 0.68rem;
    border-bottom: 1px solid #2a2a2a;
  }

  .scene-chrome span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #3a3a3a;
  }

  .scene-chrome span:first-child {
    background: #c45c4a;
  }

  .scene--build pre,
  .scene-code {
    display: grid;
    gap: 0.2rem;
    margin: 0;
    padding: 0.9rem 1rem;
    font-size: 0.72rem;
    line-height: 1.55;
    white-space: pre-wrap;
  }

  .c-dim {
    color: #6e6e6a;
  }

  .c-key {
    color: #9ecbff;
  }

  .c-warn {
    color: #e8b86d;
  }

  .c-ok {
    color: #8fd19e;
  }

  .scene--voice {
    display: grid;
    place-items: center;
    background: #f4f4f2;
  }

  .scene-orb {
    width: 8.5rem;
    height: 8.5rem;
    border-radius: 50%;
    background:
      radial-gradient(circle at 35% 30%, #ffffff 0%, transparent 32%),
      radial-gradient(circle at 60% 70%, #2a1a3a 0%, #0b0b12 55%, #000 100%);
    box-shadow: inset 0 0 2rem #5a3a8a66;
    animation: scene-orb 8s linear infinite;
  }

  @keyframes scene-pulse {
    0%,
    100% {
      opacity: 0.45;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes scene-orb {
    to {
      filter: hue-rotate(25deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene-dot,
    .scene-orb {
      animation: none;
    }
  }
</style>
