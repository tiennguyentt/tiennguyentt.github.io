  class:list={['brand-logo', className]}
  viewBox="0 0 92 18"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <text class="brand-logo__word" x="0" y="14">tienntt</text>
</svg>
