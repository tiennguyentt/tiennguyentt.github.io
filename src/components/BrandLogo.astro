---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={['brand-logo', className]}
  viewBox="0 0 116 28"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <!--
    TN mark: T crossbar with cut ends; stem is N's left post.
    Wordmark is "Tien" — readable name, not the tienntt handle.
  -->
  <g class="brand-logo__mark" fill="currentColor">
    <path d="M2 4h22.5l-2.4 4.2H14.8V24H10.2V8.2H4.4Z"></path>
    <path d="M14.8 8.2 24.6 24h-4.8L13 14.2Z"></path>
    <path d="M21.2 8.2H25.6V24H21.2Z"></path>
  </g>
  <text class="brand-logo__word" x="36" y="17">Tien</text>
  <path
    class="brand-logo__rule"
    d="M36 22.8h42"
    pathLength="1"
    stroke="var(--color-accent)"
    stroke-width="1.5"
    stroke-linecap="square"></path>
</svg>
