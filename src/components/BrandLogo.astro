---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={['brand-logo', className]}
  viewBox="0 0 118 28"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <text class="brand-logo__word" x="0" y="19">tienntt</text>
  <path
    class="brand-logo__rule"
    d="M0 24.5 H78"
    pathLength="1"
    stroke="var(--color-accent)"
    stroke-width="1.5"
    stroke-linecap="square"></path>
</svg>
