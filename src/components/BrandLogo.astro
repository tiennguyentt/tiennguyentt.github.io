---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={['brand-logo', className]}
  viewBox="0 0 90 16"
  fill="currentColor"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <g>
    <rect width="10" height="2.2"></rect>
    <rect x="3.9" width="2.2" height="16"></rect>
  </g>
  <g transform="translate(12.4 0)">
    <rect width="2.2" height="2.2"></rect>
    <rect y="4.4" width="2.2" height="11.6"></rect>
  </g>
  <g transform="translate(17.2 0)">
    <rect y="4.4" width="2.2" height="11.6"></rect>
    <rect y="4.4" width="7.6" height="2.2"></rect>
    <rect y="9.1" width="6.2" height="2.2"></rect>
    <rect y="13.8" width="7.6" height="2.2"></rect>
  </g>
  <g transform="translate(27.6 0)">
    <rect y="4.4" width="2.2" height="11.6"></rect>
    <rect y="4.4" width="7.4" height="2.2"></rect>
    <rect x="5.2" y="4.4" width="2.2" height="11.6"></rect>
  </g>
  <g transform="translate(38.2 0)">
    <rect y="4.4" width="2.2" height="11.6"></rect>
    <rect y="4.4" width="7.4" height="2.2"></rect>
    <rect x="5.2" y="4.4" width="2.2" height="11.6"></rect>
  </g>
  <g transform="translate(48.8 0)">
    <rect width="10" height="2.2"></rect>
    <rect x="3.9" width="2.2" height="16"></rect>
  </g>
  <g transform="translate(61.2 0)">
    <rect width="10" height="2.2"></rect>
    <rect x="3.9" width="2.2" height="16"></rect>
  </g>
</svg>
