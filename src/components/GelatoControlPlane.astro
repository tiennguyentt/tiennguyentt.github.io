---
/** Gelato ecosystem map — functional platform names only (NDA-safe). */
const platforms = [
  { id: 'gateway', label: 'Gateway', x: 72, y: 28 },
  { id: 'memory', label: 'Memory', x: 188, y: 22 },
  { id: 'models', label: 'Models', x: 304, y: 28 },
  { id: 'delivery', label: 'Delivery', x: 72, y: 148 },
  { id: 'scenarios', label: 'Scenarios', x: 188, y: 156 },
  { id: 'outputs', label: 'Outputs', x: 304, y: 148 },
] as const;

const hub = { id: 'ops', label: 'Ops', x: 188, y: 90 };

type PlatformId = (typeof platforms)[number]['id'];

const pos = (id: PlatformId | 'ops') => {
  if (id === 'ops') return hub;
  return platforms.find((p) => p.id === id)!;
};

/** Sparse links: hub spokes + a few peer edges. Not a full mesh. */
const links: Array<{ id: string; from: PlatformId | 'ops'; to: PlatformId | 'ops' }> = [
  { id: 'ops-gateway', from: 'ops', to: 'gateway' },
  { id: 'ops-memory', from: 'ops', to: 'memory' },
  { id: 'ops-models', from: 'ops', to: 'models' },
  { id: 'ops-delivery', from: 'ops', to: 'delivery' },
  { id: 'ops-scenarios', from: 'ops', to: 'scenarios' },
  { id: 'ops-outputs', from: 'ops', to: 'outputs' },
  { id: 'gateway-memory', from: 'gateway', to: 'memory' },
  { id: 'memory-models', from: 'memory', to: 'models' },
  { id: 'delivery-scenarios', from: 'delivery', to: 'scenarios' },
  { id: 'scenarios-outputs', from: 'scenarios', to: 'outputs' },
  { id: 'models-scenarios', from: 'models', to: 'scenarios' },
];

const frames = [
  {
    id: 'ops-gateway',
    text: 'Ops binds Gateway. One entry for every agent path.',
  },
  {
    id: 'gateway-memory',
    text: 'Gateway to Memory. Specs and sources stay linked.',
  },
  {
    id: 'memory-models',
    text: 'Memory to Models. Context feeds inference with gates.',
  },
  {
    id: 'models-scenarios',
    text: 'Models to Scenarios. Batch runs before production.',
  },
  {
    id: 'delivery-scenarios',
    text: 'Delivery to Scenarios. Build and test share one loop.',
  },
  {
    id: 'scenarios-outputs',
    text: 'Scenarios to Outputs. Humans get the handoff draft.',
  },
  {
    id: 'ops-outputs',
    text: 'Six platforms. One framework SMEs can adapt.',
  },
] as const;
---

<div class="scene scene--plane" data-live="plane" aria-hidden="true">
  <header class="plane-head">
    <div>
      <p class="plane-kicker">Agentic ops framework</p>
      <p class="plane-sub">Six platforms share one ops loop.</p>
    </div>
    <span class="plane-badge">live</span>
  </header>

  <div class="plane-body">
    <svg class="plane-map" viewBox="0 0 376 180" fill="none" xmlns="http://www.w3.org/2000/svg">
      {
        links.map((link) => {
          const from = pos(link.from);
          const to = pos(link.to);
          return (
            <line
              class="plane-link"
              x1={from.x}
              y1={from.y}
              x2={to.x}
              y2={to.y}
              data-link={link.id}
              data-from={link.from}
              data-to={link.to}
            />
          );
        })
      }

      <g class="plane-hub" data-node="ops">
        <circle class="plane-hub__ring" cx={hub.x} cy={hub.y} r="22"></circle>
        <circle class="plane-hub__dot" cx={hub.x} cy={hub.y} r="16"></circle>
        <text class="plane-hub__label" x={hub.x} y={hub.y + 3.5} text-anchor="middle"
          >{hub.label}</text
        >
      </g>

      {
        platforms.map((node) => (
          <g class="plane-node" data-node={node.id}>
            <rect
              class="plane-node__chip"
              x={node.x - 40}
              y={node.y - 12}
              width="80"
              height="24"
              rx="6"
            />
            <text class="plane-node__label" x={node.x} y={node.y + 3.5} text-anchor="middle">
              {node.label}
            </text>
          </g>
        ))
      }

      <circle class="plane-signal" cx={hub.x} cy={hub.y} r="2"></circle>
    </svg>

    <p class="plane-detail scene-live">{frames[0].text}</p>
  </div>

  <div class="scene-script" hidden>
    {frames.map((frame) => <span data-frame={frame.id}>{frame.text}</span>)}
  </div>
</div>

<style>
  /*
    Gelato sits inside a demo card whose bar already owns title (0.875rem / 600).
    Inside the scene: meta for kicker, body for live copy, SVG labels at meta optical size.
    Never bump stroke or font-weight on .is-active — color only, or active reads “larger”.
  */
  .scene--plane {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.05rem 1.15rem;
    background: #f4f4f2;
  }

  .plane-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .plane-kicker {
    margin: 0;
    color: var(--demo-ink);
    font-size: var(--demo-meta-size);
    font-weight: var(--demo-meta-weight);
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .plane-sub {
    margin: 0.15rem 0 0;
    color: var(--demo-muted);
    font-size: var(--demo-meta-size);
    font-weight: var(--demo-meta-weight);
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .plane-badge {
    color: var(--demo-muted);
    font-family: var(--font-mono);
    font-size: var(--demo-meta-size);
    font-weight: var(--demo-meta-weight);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .plane-body {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.9fr);
    gap: 0.85rem;
    flex: 1;
    min-height: 0;
    align-items: stretch;
  }

  .plane-map {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 10.5rem;
  }

  .plane-link {
    stroke: #e8e8e8;
    stroke-width: 1;
    transition: stroke 280ms ease;
  }

  .plane-link.is-live {
    stroke: var(--color-accent);
  }

  .plane-hub__ring {
    fill: none;
    stroke: var(--demo-ink);
    stroke-width: 1;
    opacity: 0.2;
  }

  .plane-hub__dot {
    fill: var(--demo-ink);
  }

  .plane-hub__label {
    fill: #ffffff;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .plane-hub.is-active .plane-hub__ring {
    stroke: var(--color-accent);
    animation: plane-hub-breathe 2.2s ease-in-out infinite;
  }

  .plane-node__chip {
    fill: #ffffff;
    stroke: #e8e8e8;
    stroke-width: 1;
    transition: stroke 280ms ease;
  }

  .plane-node__label {
    fill: var(--demo-muted);
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: -0.01em;
    transition: fill 280ms ease;
  }

  .plane-node.is-active .plane-node__chip {
    stroke: var(--color-accent);
  }

  .plane-node.is-active .plane-node__label {
    fill: var(--demo-ink);
  }

  .plane-signal {
    fill: var(--color-accent);
    opacity: 0.9;
  }

  .plane-detail {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0.65rem 0.75rem;
    border: 1px solid #e8e8e8;
    border-radius: 0.85rem;
    background: #fff;
    color: var(--demo-ink);
    font-size: var(--demo-body-size);
    font-weight: var(--demo-body-weight);
    letter-spacing: -0.01em;
    line-height: 1.4;
  }

  .plane-detail.is-enter {
    animation: plane-enter 480ms ease both;
  }

  @keyframes plane-enter {
    from {
      opacity: 0;
      transform: translateY(0.3rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes plane-hub-breathe {
    0%,
    100% {
      opacity: 0.25;
    }
    50% {
      opacity: 0.55;
    }
  }

  @media (max-width: 760px) {
    .plane-body {
      grid-template-columns: 1fr;
    }

    .plane-detail {
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plane-hub.is-active .plane-hub__ring {
      animation: none;
      opacity: 0.4;
    }
  }
</style>
