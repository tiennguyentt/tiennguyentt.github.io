---
/** Route ledger for the Gelato bento card — functional labels only. */
const routes = [
  { id: 'hub-gateway', path: 'route → gateway', state: 'open', detail: 'Gateway open.' },
  { id: 'gateway-memory', path: 'gateway → memory', state: 'linked', detail: 'Sources linked.' },
  { id: 'memory-models', path: 'memory → models', state: 'synced', detail: 'Context synced.' },
  {
    id: 'models-scenarios',
    path: 'models → scenarios',
    state: 'running',
    detail: 'Scenario batch runs.',
  },
  {
    id: 'scenarios-outputs',
    path: 'scenarios → outputs',
    state: 'draft',
    detail: 'Handoff draft ready.',
  },
  {
    id: 'pipeline-scenarios',
    path: 'delivery → scenarios',
    state: 'pass',
    detail: 'Three checks pass.',
  },
] as const;
---

<div class="scene scene--plane" data-live="plane" aria-hidden="true">
  <header class="plane-head">
    <p class="plane-kicker">Route ledger</p>
    <span class="plane-badge">live</span>
  </header>

  <div class="plane-body">
    <ol class="plane-routes">
      {
        routes.map((route) => (
          <li class="plane-row" data-route={route.id}>
            <span class="plane-path">{route.path}</span>
            <span class="plane-state">{route.state}</span>
            <span class="plane-track" aria-hidden="true">
              <i />
            </span>
          </li>
        ))
      }
    </ol>

    <p class="plane-detail scene-live">{routes[0].detail}</p>
  </div>

  <div class="scene-script" hidden>
    {routes.map((route) => <span data-frame={route.id}>{route.detail}</span>)}
  </div>
</div>

<style>
  .scene--plane {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.15rem 1.2rem 3.35rem;
    background: #f4f4f2;
  }

  .plane-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .plane-kicker {
    margin: 0;
    color: #2a2a2a;
    font-size: 0.78rem;
    font-weight: 560;
    letter-spacing: -0.02em;
  }

  .plane-badge {
    color: #6a6a6a;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .plane-body {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 1rem;
    flex: 1;
    min-height: 0;
    align-items: stretch;
  }

  .plane-routes {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .plane-row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.55rem;
    align-items: center;
    padding: 0.45rem 0.6rem;
    border-radius: 0.55rem;
    background: transparent;
    transition:
      background 280ms ease,
      box-shadow 280ms ease;
  }

  .plane-row.is-active {
    background: #fff;
    box-shadow: 0 1px 0 rgba(23, 23, 23, 0.04);
  }

  .plane-path {
    color: #5c5c5c;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: -0.01em;
    transition: color 280ms ease;
  }

  .plane-row.is-active .plane-path {
    color: #171717;
  }

  .plane-state {
    color: #9a9a96;
    font-size: 0.62rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    transition: color 280ms ease;
  }

  .plane-row.is-active .plane-state {
    color: #171717;
  }

  .plane-track {
    grid-column: 1 / -1;
    display: block;
    overflow: hidden;
    height: 0.16rem;
    border-radius: 99px;
    background: #e8e8e4;
    opacity: 0;
    transition: opacity 280ms ease;
  }

  .plane-row.is-active .plane-track {
    opacity: 1;
  }

  .plane-track i {
    display: block;
    width: 38%;
    height: 100%;
    border-radius: inherit;
    background: #171717;
    animation: plane-track 2.4s ease-in-out infinite;
  }

  .plane-detail {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0.85rem 0.95rem;
    min-height: 4.5rem;
    border-radius: 0.85rem;
    background: #fff;
    color: #171717;
    font-size: clamp(1rem, 1.6vw, 1.18rem);
    font-weight: 520;
    letter-spacing: -0.03em;
    line-height: 1.25;
  }

  .plane-detail.is-enter {
    animation: plane-enter 480ms ease both;
  }

  @keyframes plane-enter {
    from {
      opacity: 0;
      transform: translateY(0.35rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes plane-track {
    0% {
      transform: translateX(-120%);
    }
    100% {
      transform: translateX(320%);
    }
  }

  @media (max-width: 760px) {
    .plane-body {
      grid-template-columns: 1fr;
    }

    .plane-detail {
      min-height: 0;
      padding: 0.75rem 0.85rem;
      font-size: 0.95rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plane-track i {
      animation: none;
      width: 100%;
    }
  }
</style>
