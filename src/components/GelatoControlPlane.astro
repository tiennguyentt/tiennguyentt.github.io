---
/** Animated control-plane mock for the Gelato bento card. */
const nodes = [
  { id: 'core', label: 'Core', x: 160, y: 26 },
  { id: 'sdlc', label: 'SDLC', x: 48, y: 58 },
  { id: 'nexus', label: 'Nexus', x: 272, y: 58 },
  { id: 'sim', label: 'Sim', x: 48, y: 122 },
  { id: 'dsml', label: 'DS/ML', x: 272, y: 122 },
  { id: 'mkt', label: 'Mkt', x: 160, y: 154 },
] as const;

const hub = { x: 160, y: 90 };
---

<div class="scene scene--plane" data-live="plane" aria-hidden="true">
  <div class="plane-chrome">
    <span></span>
    <span></span>
    <span></span>
    gelato · control plane
  </div>

  <svg class="plane-svg" viewBox="0 0 320 180" fill="none" xmlns="http://www.w3.org/2000/svg">
    {
      nodes.map((node) => (
        <line
          class="plane-link"
          x1={hub.x}
          y1={hub.y}
          x2={node.x}
          y2={node.y}
          data-link={node.id}
        />
      ))
    }

    <circle class="plane-hub" cx={hub.x} cy={hub.y} r="22"></circle>
    <text class="plane-hub-label" x={hub.x} y={hub.y + 4} text-anchor="middle"> 00 </text>

    {
      nodes.map((node) => (
        <g class="plane-node" data-node={node.id}>
          <circle class="plane-node__ring" cx={node.x} cy={node.y} r="18" />
          <circle class="plane-node__dot" cx={node.x} cy={node.y} r="14" />
          <text class="plane-node__label" x={node.x} y={node.y + 3.5} text-anchor="middle">
            {node.label}
          </text>
        </g>
      ))
    }

    <circle class="plane-pulse" cx={hub.x} cy={hub.y} r="22"></circle>
  </svg>

  <p class="plane-status scene-live">Route · Core gateway · gate open</p>

  <div class="scene-script" hidden>
    <span data-frame="core">Route · Core gateway · gate open</span>
    <span data-frame="sdlc">Route · SDLC tests · 3 agents queued</span>
    <span data-frame="nexus">Route · Nexus graph · memory synced</span>
    <span data-frame="sim">Route · Simulation · scenario 12 running</span>
    <span data-frame="dsml">Route · DS/ML · eval pass 0.94</span>
    <span data-frame="mkt">Route · Marketplace · listing draft</span>
  </div>
</div>

<style>
  .scene--plane {
    display: flex;
    flex-direction: column;
    padding: 0;
    background: #f4f4f2;
  }

  .plane-chrome {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.65rem 0.85rem;
    color: #6a6a6a;
    font-size: 0.68rem;
    letter-spacing: -0.01em;
    border-bottom: 1px solid #e4e4e0;
  }

  .plane-chrome span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #d0d0cc;
  }

  .plane-chrome span:first-child {
    background: #e31937;
  }

  .plane-svg {
    display: block;
    width: 100%;
    flex: 1;
    min-height: 9.5rem;
    padding: 0.35rem 0.5rem 0;
  }

  .plane-link {
    stroke: #c8c8c4;
    stroke-width: 1.4;
    stroke-dasharray: 5 7;
    animation: plane-flow 2.4s linear infinite;
  }

  .plane-link[data-link='core'] {
    animation-delay: 0s;
  }

  .plane-link[data-link='sdlc'] {
    animation-delay: 0.35s;
  }

  .plane-link[data-link='nexus'] {
    animation-delay: 0.7s;
  }

  .plane-link[data-link='sim'] {
    animation-delay: 1.05s;
  }

  .plane-link[data-link='dsml'] {
    animation-delay: 1.4s;
  }

  .plane-link[data-link='mkt'] {
    animation-delay: 1.75s;
  }

  .plane-hub {
    fill: #171717;
  }

  .plane-hub-label {
    fill: #ffffff;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
  }

  .plane-node__ring {
    fill: none;
    stroke: #e31937;
    stroke-width: 2;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity 280ms ease;
  }

  .plane-node__dot {
    fill: #ffffff;
    stroke: #d8d8d4;
    stroke-width: 1.2;
  }

  .plane-node__label {
    fill: #171717;
    font-family: var(--font-body);
    font-size: 9px;
    font-weight: 560;
    letter-spacing: -0.02em;
  }

  .plane-node.is-active .plane-node__ring {
    opacity: 1;
    animation: plane-node-pulse 1.8s ease-in-out infinite;
  }

  .plane-node.is-active .plane-node__dot {
    stroke: #e31937;
  }

  .plane-pulse {
    fill: none;
    stroke: #e31937;
    stroke-width: 1;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: plane-hub-pulse 2.8s ease-out infinite;
  }

  .plane-status {
    margin: 0;
    padding: 0.65rem 0.95rem 3.35rem;
    color: #5c5c5c;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.45;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @keyframes plane-flow {
    to {
      stroke-dashoffset: -24;
    }
  }

  @keyframes plane-node-pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.85;
    }
    50% {
      transform: scale(1.08);
      opacity: 1;
    }
  }

  @keyframes plane-hub-pulse {
    0% {
      transform: scale(1);
      opacity: 0.45;
    }
    100% {
      transform: scale(1.55);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plane-link,
    .plane-pulse,
    .plane-node.is-active .plane-node__ring {
      animation: none;
    }
  }
</style>
