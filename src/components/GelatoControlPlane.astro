---
/** Gelato ecosystem map — functional platform names only (NDA-safe). */
const platforms = [
  { id: 'gateway', label: 'Gateway', x: 72, y: 28 },
  { id: 'memory', label: 'Memory', x: 188, y: 22 },
  { id: 'models', label: 'Models', x: 304, y: 28 },
  { id: 'delivery', label: 'Delivery', x: 72, y: 148 },
  { id: 'scenarios', label: 'Scenarios', x: 188, y: 156 },
  { id: 'outputs', label: 'Outputs', x: 304, y: 148 },
] as const;

const hub = { id: 'ops', label: 'Ops', x: 188, y: 90 };

type PlatformId = (typeof platforms)[number]['id'];

const pos = (id: PlatformId | 'ops') => {
  if (id === 'ops') return hub;
  return platforms.find((p) => p.id === id)!;
};

/** Sparse links: hub spokes + a few peer edges. Not a full mesh. */
const links: Array<{ id: string; from: PlatformId | 'ops'; to: PlatformId | 'ops' }> = [
  { id: 'ops-gateway', from: 'ops', to: 'gateway' },
  { id: 'ops-memory', from: 'ops', to: 'memory' },
  { id: 'ops-models', from: 'ops', to: 'models' },
  { id: 'ops-delivery', from: 'ops', to: 'delivery' },
  { id: 'ops-scenarios', from: 'ops', to: 'scenarios' },
  { id: 'ops-outputs', from: 'ops', to: 'outputs' },
  { id: 'gateway-memory', from: 'gateway', to: 'memory' },
  { id: 'memory-models', from: 'memory', to: 'models' },
  { id: 'delivery-scenarios', from: 'delivery', to: 'scenarios' },
  { id: 'scenarios-outputs', from: 'scenarios', to: 'outputs' },
  { id: 'models-scenarios', from: 'models', to: 'scenarios' },
];

const frames = [
  {
    id: 'ops-gateway',
    text: 'Ops binds Gateway. One entry for every agent path.',
  },
  {
    id: 'gateway-memory',
    text: 'Gateway ↔ Memory. Specs and sources stay linked.',
  },
  {
    id: 'memory-models',
    text: 'Memory ↔ Models. Context feeds inference with gates.',
  },
  {
    id: 'models-scenarios',
    text: 'Models ↔ Scenarios. Batch runs before production.',
  },
  {
    id: 'delivery-scenarios',
    text: 'Delivery ↔ Scenarios. Build and test share one loop.',
  },
  {
    id: 'scenarios-outputs',
    text: 'Scenarios ↔ Outputs. Humans get the handoff draft.',
  },
  {
    id: 'ops-outputs',
    text: 'Six platforms. One framework SMEs can adapt.',
  },
] as const;
---

<div class="scene scene--plane" data-live="plane" aria-hidden="true">
  <header class="plane-head">
    <div>
      <p class="plane-kicker">Agentic ops framework</p>
      <p class="plane-sub">Platforms connect. Ecosystems adapt.</p>
    </div>
    <span class="plane-badge">live</span>
  </header>

  <div class="plane-body">
    <svg class="plane-map" viewBox="0 0 376 180" fill="none" xmlns="http://www.w3.org/2000/svg">
      {
        links.map((link) => {
          const from = pos(link.from);
          const to = pos(link.to);
          return (
            <line
              class="plane-link"
              x1={from.x}
              y1={from.y}
              x2={to.x}
              y2={to.y}
              data-link={link.id}
              data-from={link.from}
              data-to={link.to}
            />
          );
        })
      }

      <g class="plane-hub" data-node="ops">
        <circle class="plane-hub__ring" cx={hub.x} cy={hub.y} r="26"></circle>
        <circle class="plane-hub__dot" cx={hub.x} cy={hub.y} r="20"></circle>
        <text class="plane-hub__label" x={hub.x} y={hub.y + 4} text-anchor="middle"
          >{hub.label}</text
        >
      </g>

      {
        platforms.map((node) => (
          <g class="plane-node" data-node={node.id}>
            <rect
              class="plane-node__chip"
              x={node.x - 42}
              y={node.y - 14}
              width="84"
              height="28"
              rx="8"
            />
            <text class="plane-node__label" x={node.x} y={node.y + 4} text-anchor="middle">
              {node.label}
            </text>
          </g>
        ))
      }

      <circle class="plane-signal" cx={hub.x} cy={hub.y} r="3"></circle>
    </svg>

    <p class="plane-detail scene-live">{frames[0].text}</p>
  </div>

  <div class="scene-script" hidden>
    {frames.map((frame) => <span data-frame={frame.id}>{frame.text}</span>)}
  </div>
</div>

<style>
  .scene--plane {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.05rem 1.15rem 3.25rem;
    background: #f4f4f2;
  }

  .plane-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .plane-kicker {
    margin: 0;
    color: #171717;
    font-size: 0.78rem;
    font-weight: 560;
    letter-spacing: -0.02em;
  }

  .plane-sub {
    margin: 0.15rem 0 0;
    color: #6a6a6a;
    font-size: 0.7rem;
    letter-spacing: -0.01em;
  }

  .plane-badge {
    color: #6a6a6a;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .plane-body {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.9fr);
    gap: 0.85rem;
    flex: 1;
    min-height: 0;
    align-items: stretch;
  }

  .plane-map {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 10.5rem;
  }

  .plane-link {
    stroke: #d8d8d4;
    stroke-width: 1.2;
    transition:
      stroke 280ms ease,
      stroke-width 280ms ease;
  }

  .plane-link.is-live {
    stroke: #171717;
    stroke-width: 1.8;
  }

  .plane-hub__ring {
    fill: none;
    stroke: #171717;
    stroke-width: 1.2;
    opacity: 0.2;
    transform-box: fill-box;
    transform-origin: center;
  }

  .plane-hub__dot {
    fill: #171717;
  }

  .plane-hub__label {
    fill: #ffffff;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .plane-hub.is-active .plane-hub__ring {
    opacity: 0.55;
    animation: plane-hub-breathe 2.2s ease-in-out infinite;
  }

  .plane-node__chip {
    fill: #ffffff;
    stroke: #d8d8d4;
    stroke-width: 1.2;
    transition:
      stroke 280ms ease,
      fill 280ms ease;
  }

  .plane-node__label {
    fill: #5c5c5c;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 560;
    letter-spacing: -0.02em;
    transition: fill 280ms ease;
  }

  .plane-node.is-active .plane-node__chip {
    stroke: #171717;
    fill: #ffffff;
  }

  .plane-node.is-active .plane-node__label {
    fill: #171717;
  }

  .plane-signal {
    fill: #171717;
    opacity: 0.9;
  }

  .plane-detail {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0.85rem 0.95rem;
    border-radius: 0.85rem;
    background: #fff;
    color: #171717;
    font-size: clamp(0.92rem, 1.5vw, 1.08rem);
    font-weight: 520;
    letter-spacing: -0.03em;
    line-height: 1.3;
  }

  .plane-detail.is-enter {
    animation: plane-enter 480ms ease both;
  }

  @keyframes plane-enter {
    from {
      opacity: 0;
      transform: translateY(0.3rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes plane-hub-breathe {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.45;
    }
    50% {
      transform: scale(1.08);
      opacity: 0.75;
    }
  }

  @media (max-width: 760px) {
    .plane-body {
      grid-template-columns: 1fr;
    }

    .plane-detail {
      min-height: 0;
      font-size: 0.92rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plane-hub.is-active .plane-hub__ring {
      animation: none;
    }
  }
</style>
