---
/** Public conceptual map of personal research, not an employer architecture. */
const layers = [
  { id: 'gateway', label: 'Gateway', x: 72, y: 28 },
  { id: 'memory', label: 'Memory', x: 188, y: 28 },
  { id: 'models', label: 'Models', x: 304, y: 28 },
  { id: 'delivery', label: 'Delivery', x: 72, y: 172 },
  { id: 'scenarios', label: 'Scenarios', x: 188, y: 172 },
  { id: 'outputs', label: 'Outputs', x: 304, y: 172 },
] as const;

const hub = { x: 188, y: 100 };
const nodeHalfWidth = 54;
const nodeHalfHeight = 22;

const linkBetween = (layer: (typeof layers)[number]) => {
  const dx = layer.x - hub.x;
  const dy = layer.y - hub.y;
  const edgeRatio = Math.min(
    dx === 0 ? Infinity : nodeHalfWidth / Math.abs(dx),
    dy === 0 ? Infinity : nodeHalfHeight / Math.abs(dy),
  );

  return {
    x1: hub.x + dx * edgeRatio,
    y1: hub.y + dy * edgeRatio,
    x2: layer.x - dx * edgeRatio,
    y2: layer.y - dy * edgeRatio,
  };
};
---

<div class="scene scene--plane">
  <header class="plane-head">
    <div>
      <p class="plane-kicker">Personal research</p>
      <p class="plane-sub">An in-progress map of agent routing, checks, and approval.</p>
    </div>
    <span class="plane-badge">In progress</span>
  </header>

  <div class="plane-body">
    <svg
      class="plane-map"
      viewBox="0 0 376 200"
      role="img"
      aria-label="Conceptual map: Ops connects Gateway, Memory, Models, Delivery, Scenarios, and Outputs."
      xmlns="http://www.w3.org/2000/svg"
    >
      {
        layers.map((layer) => {
          const link = linkBetween(layer);
          return <line class="plane-link" x1={link.x1} y1={link.y1} x2={link.x2} y2={link.y2} />;
        })
      }

      <g class="plane-hub">
        <rect x={hub.x - 54} y={hub.y - 22} width="108" height="44" rx="12"></rect>
        <text class="plane-hub__type" x={hub.x} y={hub.y - 3} text-anchor="middle">Control</text>
        <text class="plane-hub__label" x={hub.x} y={hub.y + 13} text-anchor="middle">Ops</text>
      </g>

      {
        layers.map((layer) => (
          <g class="plane-node">
            <rect x={layer.x - 54} y={layer.y - 22} width="108" height="44" rx="12" />
            <text class="plane-node__type" x={layer.x} y={layer.y - 3} text-anchor="middle">
              Layer
            </text>
            <text class="plane-node__label" x={layer.x} y={layer.y + 13} text-anchor="middle">
              {layer.label}
            </text>
          </g>
        ))
      }
    </svg>

    <ol class="plane-list" aria-label="Conceptual layers">
      <li><span>Control</span>Ops</li>
      {
        layers.map((layer) => (
          <li>
            <span>Layer</span>
            {layer.label}
          </li>
        ))
      }
    </ol>

    <div class="plane-detail">
      <span class="plane-detail__state">Overview</span>
      <h3>Six supporting layers</h3>
      <p>
        The operations control point connects gateway, memory, models, delivery, scenarios and
        outputs. The design places execution behind recorded checks and human approval.
      </p>
    </div>
  </div>
</div>

<style>
  .scene--plane {
    display: flex;
    height: 100%;
    min-height: 20rem;
    flex-direction: column;
    gap: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--color-paper);
  }

  .plane-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .plane-kicker {
    margin: 0;
    color: var(--color-text);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .plane-sub {
    max-width: 32rem;
    margin: 0.4rem 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .plane-badge {
    display: inline-flex;
    min-height: 1.875rem;
    align-items: center;
    flex-shrink: 0;
    padding: 0.35rem 0.75rem;
    border-radius: 0.5rem;
    color: var(--color-accent);
    background: rgb(242 166 35 / 8%);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .plane-body {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(13rem, 5fr);
    gap: 1.5rem;
    align-items: start;
  }

  .plane-map {
    display: block;
    width: 100%;
    height: auto;
  }

  .plane-link {
    stroke: var(--color-line-strong);
    stroke-width: 1;
  }

  .plane-hub rect {
    fill: var(--color-ink);
  }

  .plane-hub__type,
  .plane-hub__label {
    fill: var(--color-surface);
    font-family: var(--font-body);
  }

  .plane-hub__type,
  .plane-node__type {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .plane-hub__type {
    opacity: 0.72;
  }

  .plane-hub__label,
  .plane-node__label {
    font-size: 14px;
    font-weight: 600;
  }

  .plane-node rect {
    fill: var(--color-surface);
    stroke: var(--color-line);
    stroke-width: 1;
  }

  .plane-node__type,
  .plane-node__label {
    fill: var(--color-text);
    font-family: var(--font-body);
  }

  .plane-node__type {
    fill: var(--color-muted);
  }

  .plane-list {
    display: none;
  }

  .plane-detail {
    padding: 1.5rem;
    border: 1px solid var(--line-structure);
    border-radius: 1rem;
    background: var(--color-surface);
  }

  .plane-detail__state {
    display: block;
    margin-bottom: 0.75rem;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .plane-detail h3 {
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }

  .plane-detail p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  @media (max-width: 1024px) {
    .scene--plane {
      min-height: 0;
    }

    .plane-head {
      flex-wrap: wrap;
    }

    .plane-body {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  @media (max-width: 760px) {
    .plane-map {
      display: none;
    }

    .plane-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .plane-list li {
      display: grid;
      min-height: 3rem;
      gap: 0.1rem;
      padding: 0.5rem 0.75rem;
      border: 1px solid var(--color-line);
      border-radius: 0.75rem;
      background: var(--color-surface);
      font-size: 0.875rem;
      font-weight: 600;
    }

    .plane-list span {
      color: var(--color-muted);
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
    }

    .plane-detail {
      padding: 1rem;
    }
  }

  @media (max-width: 599px) {
    .plane-list {
      grid-template-columns: 1fr;
    }
  }
</style>
