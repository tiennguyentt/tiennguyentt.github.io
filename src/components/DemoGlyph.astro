---
interface Props {
  kind: 'knowledge' | 'sport' | 'recon' | 'gelato';
}

const { kind } = Astro.props;
---

<svg class={`demo-glyph demo-glyph--${kind}`} viewBox="0 0 64 64" aria-hidden="true" fill="none">
  {
    kind === 'knowledge' && (
      <>
        <rect
          class="g-frame"
          x="16"
          y="12"
          width="32"
          height="40"
          rx="3"
          stroke="currentColor"
          stroke-width="1.6"
        />
        <path
          class="g-draw g-draw-1"
          d="M24 24h16"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        />
        <path
          class="g-draw g-draw-2"
          d="M24 32h16"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        />
        <path
          class="g-draw g-draw-3"
          d="M24 40h10"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        />
        <circle class="g-pulse" cx="44" cy="44" r="4" stroke="currentColor" stroke-width="1.6" />
        <path
          class="g-check"
          d="M41.8 44.1l1.5 1.5 3.2-3.4"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </>
    )
  }
  {
    kind === 'sport' && (
      <>
        <path
          class="g-draw"
          d="M14 42l10-14 8 8 12-18"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <circle class="g-orbit" cx="44" cy="18" r="5" stroke="currentColor" stroke-width="1.6" />
        <rect
          class="g-gate"
          x="18"
          y="46"
          width="28"
          height="6"
          rx="1.5"
          stroke="currentColor"
          stroke-width="1.6"
        />
        <path
          class="g-pulse-line"
          d="M22 49h8"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        />
      </>
    )
  }
  {
    kind === 'recon' && (
      <>
        <circle cx="32" cy="32" r="18" stroke="currentColor" stroke-width="1.4" opacity="0.35" />
        <circle cx="32" cy="32" r="11" stroke="currentColor" stroke-width="1.4" opacity="0.55" />
        <circle class="g-pulse" cx="32" cy="32" r="3" fill="currentColor" />
        <path
          class="g-sweep"
          d="M32 32 L32 14 A18 18 0 0 1 46.5 23.5 Z"
          fill="currentColor"
          opacity="0.18"
        />
        <path
          class="g-sweep-edge"
          d="M32 14 A18 18 0 0 1 46.5 23.5"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        />
      </>
    )
  }
  {
    kind === 'gelato' && (
      <>
        <circle
          class="g-node g-node-a"
          cx="20"
          cy="22"
          r="4"
          stroke="currentColor"
          stroke-width="1.6"
        />
        <circle
          class="g-node g-node-b"
          cx="44"
          cy="20"
          r="4"
          stroke="currentColor"
          stroke-width="1.6"
        />
        <circle
          class="g-node g-node-c"
          cx="32"
          cy="42"
          r="4"
          stroke="currentColor"
          stroke-width="1.6"
        />
        <path
          class="g-link g-link-1"
          d="M24 22h16"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
        />
        <path
          class="g-link g-link-2"
          d="M23 25.5 L29.5 38"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
        />
        <path
          class="g-link g-link-3"
          d="M41 25.5 L34.5 38"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
        />
        <path
          class="g-spin"
          d="M28 32h8"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
        />
      </>
    )
  }
</svg>

<style>
  .demo-glyph {
    width: 3.25rem;
    height: 3.25rem;
    color: #1a1a1a;
    overflow: visible;
  }

  .g-draw,
  .g-check,
  .g-sweep-edge,
  .g-link {
    stroke-dasharray: 48;
    stroke-dashoffset: 48;
    animation: glyph-draw 2.8s ease forwards infinite;
  }

  .g-draw-2 {
    animation-delay: 0.18s;
  }

  .g-draw-3,
  .g-check {
    animation-delay: 0.32s;
  }

  .g-link-2 {
    animation-delay: 0.2s;
  }

  .g-link-3 {
    animation-delay: 0.35s;
  }

  .g-pulse,
  .g-node {
    transform-origin: center;
    transform-box: fill-box;
    animation: glyph-pulse 2.4s ease-in-out infinite;
  }

  .g-node-b {
    animation-delay: 0.25s;
  }

  .g-node-c {
    animation-delay: 0.5s;
  }

  .g-orbit {
    transform-origin: 44px 18px;
    animation: glyph-orbit 4.5s linear infinite;
  }

  .g-pulse-line {
    animation: glyph-blink 1.8s ease-in-out infinite;
  }

  .g-sweep,
  .g-sweep-edge {
    transform-origin: 32px 32px;
    animation: glyph-spin 5s linear infinite;
  }

  .g-spin {
    transform-origin: 32px 32px;
    animation: glyph-spin 6s linear infinite;
  }

  @keyframes glyph-draw {
    0% {
      stroke-dashoffset: 48;
      opacity: 0.35;
    }
    35%,
    70% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    100% {
      stroke-dashoffset: 48;
      opacity: 0.35;
    }
  }

  @keyframes glyph-pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.7;
    }
    50% {
      transform: scale(1.12);
      opacity: 1;
    }
  }

  @keyframes glyph-orbit {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes glyph-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes glyph-blink {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-glyph * {
      animation: none !important;
      stroke-dashoffset: 0 !important;
      opacity: 1 !important;
    }
  }
</style>
