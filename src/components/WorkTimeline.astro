---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';
import { formatDate } from '../i18n';

interface Props {
  works: CollectionEntry<'works'>[];
}

const { works } = Astro.props;
---

<ol class="work-grid">
  {
    works.map((work) => {
      const href = work.data.link ?? withBase(`/works/${work.id}/`);
      const external = Boolean(work.data.link);

      return (
        <li class="work-grid__item">
          <article class="work-grid__panel">
            <div class="work-grid__meta">
              <time datetime={work.data.publishDate.toISOString()}>
                {formatDate(work.data.publishDate, 'short')}
              </time>
              <span>{external ? 'Live demo' : 'In progress'}</span>
            </div>
            <h2>
              <a
                href={href}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
              >
                {work.data.title}
              </a>
            </h2>
            <p>{work.data.description}</p>
            <p class="work-grid__tags">{work.data.tech.slice(0, 3).join(' · ')}</p>
          </article>
        </li>
      );
    })
  }
</ol>
