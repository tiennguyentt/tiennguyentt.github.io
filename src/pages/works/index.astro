---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkTimeline from '../../components/WorkTimeline.astro';
import { SITE } from '../../consts';

const useCases = (await getCollection('works'))
  .filter((work) => work.data.link || work.id.startsWith('gelato'))
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
---

<BaseLayout
  title="Work"
  description={`Selected work: Gelato, Knowledge Engine, Recon, Sport Quant. ${SITE.title}.`}
>
  <section class="page-head section">
    <p class="eyebrow">Work</p>
    <h1>Selected work</h1>
    <p class="lead">Open an app or read the project notes. If an app is asleep, wake it up.</p>
  </section>

  <section class="section" aria-label="Selected work">
    <WorkTimeline works={useCases} />
  </section>
</BaseLayout>
