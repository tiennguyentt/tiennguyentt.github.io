---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';
import { SITE } from '../../consts';
import { formatDate } from '../../i18n';

const works = (await getCollection('works')).sort((a, b) => {
  const orderA = a.data.order ?? Number.MAX_SAFE_INTEGER;
  const orderB = b.data.order ?? Number.MAX_SAFE_INTEGER;
  if (orderA !== orderB) return orderA - orderB;
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});
---

<BaseLayout
  title="Work"
  description={`Live demos first (Knowledge Engine, Sport Quant, Recon), then Gelato narrative, then resume-backed Colonial delivery. ${SITE.title}.`}
>
  <section class="page-head section">
    <p class="eyebrow">Work</p>
    <h1>Demo use cases that get interview attention.</h1>
    <p class="lead">
      Live today: Knowledge Engine, Sport Quant, Recon. Gelato platforms: scaffold — building.
      Colonial = resume-only. No employer internals.
    </p>
  </section>

  <section class="section" aria-label="Case study list">
    <div class="work-list">
      {
        works.map((work) => (
          <article class="work-card work-card--list">
            <p class="entry-meta">
              <time datetime={work.data.publishDate.toISOString()}>
                {formatDate(work.data.publishDate, 'short')}
              </time>
              <span>{work.data.tech.slice(0, 3).join(' · ')}</span>
              {work.data.link ? <span>Live demo</span> : <span>No public demo</span>}
            </p>
            <h2>
              <a href={withBase(`/works/${work.id}/`)}>{work.data.title}</a>
            </h2>
            <p>{work.data.description}</p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
