---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';
import { SITE } from '../../consts';
import { formatDate } from '../../i18n';

const works = (await getCollection('works')).sort((a, b) => {
  const orderA = a.data.order ?? Number.MAX_SAFE_INTEGER;
  const orderB = b.data.order ?? Number.MAX_SAFE_INTEGER;
  if (orderA !== orderB) return orderA - orderB;
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});

const useCases = works.filter((w) => w.data.link || w.id.startsWith('gelato'));
const resumeItems = works.filter((w) => !w.data.link && !w.id.startsWith('gelato'));
---

<BaseLayout
  title="Work"
  description={`Use cases: Knowledge Engine, Sport Quant, Recon. Gelato in progress. ${SITE.title}.`}
>
  <section class="page-head section">
    <p class="eyebrow">Work</p>
    <h1>Use cases</h1>
    <p class="lead">
      Live demos you can open. Gelato is still under construction. Employer delivery stays on the
      resume timeline below.
    </p>
  </section>

  <section class="section" aria-label="Use cases">
    <div class="work-list">
      {
        useCases.map((work) => (
          <article class="work-card work-card--list">
            <p class="entry-meta">
              <time datetime={work.data.publishDate.toISOString()}>
                {formatDate(work.data.publishDate, 'short')}
              </time>
              <span>{work.data.tech.slice(0, 3).join(' · ')}</span>
              {work.data.link ? <span>Live demo</span> : <span>In progress</span>}
            </p>
            <h2>
              <a href={withBase(`/works/${work.id}/`)}>{work.data.title}</a>
            </h2>
            <p>{work.data.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  {
    resumeItems.length > 0 && (
      <section class="section resume-band" aria-labelledby="resume-timeline">
        <p class="kicker">Resume</p>
        <h2 id="resume-timeline">Resume timeline</h2>
        <p class="lead narrow">Same facts as the PDF. No public demo. No employer internals.</p>
        <div class="work-list">
          {resumeItems.map((work) => (
            <article class="work-card work-card--list">
              <p class="entry-meta">
                <time datetime={work.data.publishDate.toISOString()}>
                  {formatDate(work.data.publishDate, 'short')}
                </time>
                <span>{work.data.tech.slice(0, 3).join(' · ')}</span>
                <span>Resume</span>
              </p>
              <h2>
                <a href={withBase(`/works/${work.id}/`)}>{work.data.title}</a>
              </h2>
              <p>{work.data.description}</p>
            </article>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
