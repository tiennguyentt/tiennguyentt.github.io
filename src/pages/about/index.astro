---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { RESUME_PAGE, RESUME_PDF } from '../../consts';
import { withBase } from '../../lib/url';

const resumePage = withBase(RESUME_PAGE);
const resumePdf = withBase(RESUME_PDF);
---

<BaseLayout
  title="About"
  description="Tien Nguyen works across payments, consumer products, and agentic operations as a product manager and technical product owner."
>
  <section class="page-head section">
    <p class="eyebrow">About</p>
    <h1>Product work, from requirements to release.</h1>
    <p class="lead">
      I have worked on payment migrations, mobile booking, insurance product rules, and agentic
      operations. The work changes by domain; the job is still to make the requirements clear and
      get the product into use.
    </p>
  </section>

  <section class="section prose-grid">
    <div>
      <p class="eyebrow">How I run it</p>
      <h2>How I work</h2>
    </div>
    <div class="prose-stack">
      <p>
        I write the requirements, work through edge cases with engineers, and check what ships. For
        AI-led operations, I also specify policy checks and human approval before execution.
      </p>
    </div>
  </section>

  <section class="section prose-grid">
    <div>
      <p class="eyebrow">Present</p>
      <h2>GSM - Green SM (Vingroup)</h2>
    </div>
    <div class="prose-stack">
      <p>
        I own product requirements for agentic operations at{' '}
        <a href="https://www.greensm.com/vn-vi" target="_blank" rel="noopener noreferrer"
          >Green SM</a
        >, also called GSM, a Vingroup company. The platform observes fleet signals and recommends
        actions. Policy checks and human approval gate execution. My title and dates are on the
        resume; internal details stay off this site.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="resume-timeline">
    <p class="kicker">Resume</p>
    <h2 id="resume-timeline">Career timeline</h2>
    <p class="lead narrow">Roles and dates match the downloadable resume.</p>
    <div class="about-ledger">
      <article>
        <span>Jul 2026-Present</span>
        <h3>GSM - Green SM (Vingroup)</h3>
        <p>
          I own the product for agentic ops: AI proposes; people approve before anything executes.
          Details on the resume.
        </p>
      </article>
      <article>
        <span>Feb 2026-Jul 2026</span>
        <h3>Colonial Surety</h3>
        <p>
          Product Engineering contract. Led a PCI payment gateway cutover, designed an insurance
          application flow, and wrote B2B single sign-on requirements.
        </p>
      </article>
      <article>
        <span>2019-2026</span>
        <h3>Hoookie, Olmo, ERP</h3>
        <p>
          Product Manager at Hoookie, Product Owner at Olmo, and Associate Product Manager at 4/10.
        </p>
      </article>
    </div>
  </section>

  <section class="section prose-grid about-closing">
    <div>
      <p class="eyebrow">Next</p>
      <h2>See the work</h2>
    </div>
    <div class="prose-stack">
      <p>
        The Work page has personal projects and live demos. Green SM and Colonial appear here and on
        the resume, without internal product details.
      </p>
      <div class="action-row">
        <a class="button" href={withBase('/works/')}>View work</a>
        <a class="text-link" href={resumePage}>View resume</a>
        <a class="text-link" href={resumePdf} data-astro-reload download="Tien-Nguyen-CV.pdf"
          >Download PDF</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
