---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { RESUME_PAGE, RESUME_PDF } from '../../consts';
import { withBase } from '../../lib/url';

const resumePage = withBase(RESUME_PAGE);
const resumePdf = withBase(RESUME_PDF);
---

<BaseLayout
  title="About"
  description="Tien Nguyen - AI Product Manager / Lead AI Technical Product Owner for enterprise agentic operations in Ho Chi Minh City."
>
  <section class="page-head section">
    <p class="eyebrow">About</p>
    <h1>Applied AI Enterprise</h1>
    <p class="lead">
      I own the product for agentic ops at GSM: AI proposes; people approve before anything
      executes.
    </p>
  </section>

  <section class="section prose-grid">
    <div>
      <p class="eyebrow">How I run it</p>
      <h2>One operating loop</h2>
    </div>
    <div class="prose-stack">
      <p>
        Observe, detect, explain, recommend, approve, execute, verify, then learn. AI proposes;
        people approve before anything executes.
      </p>
    </div>
  </section>

  <section class="section prose-grid">
    <div>
      <p class="eyebrow">Present</p>
      <h2>GSM - Green SM (Vingroup)</h2>
    </div>
    <div class="prose-stack">
      <p>
        I lead product for an enterprise agentic operations platform at{' '}
        <a href="https://www.greensm.com/vn-vi" target="_blank" rel="noopener noreferrer"
          >Green SM</a
        >, also called GSM, a Vingroup company. The system watches signals, proposes actions, and
        only runs them after policy checks and human approval. Title and dates are on the resume.
        Internals stay off this site.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="resume-timeline">
    <p class="kicker">Resume</p>
    <h2 id="resume-timeline">Career timeline</h2>
    <p class="lead narrow">Same employers and facts as the PDF.</p>
    <div class="about-ledger">
      <article>
        <span>Jul 2026-Present</span>
        <h3>GSM - Green SM (Vingroup)</h3>
        <p>
          I own the product for agentic ops: AI proposes; people approve before anything executes.
          Details on the resume.
        </p>
      </article>
      <article>
        <span>Feb 2026-Jul 2026</span>
        <h3>Colonial Surety</h3>
        <p>
          PE contract. Insurtech and B2B fintech delivery: PM controls, PCI gateway cutover,
          seven-product bundling, B2B SSO scoping.
        </p>
      </article>
      <article>
        <span>2019-2026</span>
        <h3>Hoookie, Olmo, ERP</h3>
        <p>Hoookie PM (2023-2026), Olmo PO (+30% bookings), and a 4/10 APM path.</p>
      </article>
    </div>
  </section>

  <section class="section prose-grid about-closing">
    <div>
      <p class="eyebrow">Next</p>
      <h2>Start with the live systems</h2>
    </div>
    <div class="prose-stack">
      <p>
        Open Gelato, then Knowledge Engine, and Recon. Green SM and Colonial stay on this timeline
        and the PDF. They are not public product tours.
      </p>
      <div class="action-row">
        <a class="button" href={withBase('/works/')}>View work</a>
        <a class="text-link" href={resumePage}>View resume</a>
        <a class="text-link" href={resumePdf} data-astro-reload download="Tien-Nguyen-CV.pdf"
          >Download PDF</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
