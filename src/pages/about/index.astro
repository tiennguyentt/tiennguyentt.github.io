---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';
---

<BaseLayout
  title="About"
  description="Tien Nguyen, AI product manager in Ho Chi Minh City. Green SM platform ops by day. Public demos: Knowledge Engine, Recon, Sport Quant. Gelato in progress."
>
  <section class="page-head section">
    <p class="eyebrow">About</p>
    <h1>What I do at work, and what you can click.</h1>
    <p class="lead">
      AI product manager and product owner in Ho Chi Minh City. Former full-stack engineer. The
      resume PDF is being refreshed. This page is the current map.
    </p>
  </section>

  <section class="section prose-grid">
    <div>
      <p class="eyebrow">Now</p>
      <h2>Green SM / GSM (Vingroup), platform ops</h2>
    </div>
    <div class="prose-stack">
      <p>
        Day job: platform operations across Green SM ecosystems under Vingroup (
        <a href="https://www.greensm.com/vn-vi" target="_blank" rel="noopener noreferrer"
          >greensm.com</a
        >). Title and timeline go on the resume. Internals stay confidential.
      </p>
    </div>
  </section>

  <section class="section" aria-label="Career overview">
    <div class="about-ledger">
      <article>
        <span>01</span>
        <h3>Employers</h3>
        <p>
          Green SM / GSM (Vingroup): current platform ops. Colonial Surety: earlier insurtech and
          B2B fintech work (PCI cutover, product bundling, SSO, PM controls), resume facts only.
          Hoookie (Keeta, Sire.bot), Olmo (+30% bookings), and a 4/10 ERP path earlier.
        </p>
      </article>
      <article>
        <span>02</span>
        <h3>Public systems</h3>
        <p>
          Knowledge Engine, Sport Quant, and Recon are live. Gelato platforms are in progress: a
          control plane plus six verticals.
        </p>
      </article>
      <article>
        <span>03</span>
        <h3>Also in flight</h3>
        <p>
          Petmood (pet triage beta, HCMC), AnDigi (insurance operated by agents, still in design),
          and advisory work with Vietnam fashion-retail SMEs.
        </p>
      </article>
    </div>
  </section>

  <section class="section prose-grid about-closing">
    <div>
      <p class="eyebrow">How to read this</p>
      <h2>Start with the live systems. Ask about employers next.</h2>
    </div>
    <div class="prose-stack">
      <p>
        Open Knowledge Engine first, then Sport Quant, then Recon. Green SM and Colonial stay on the
        resume and in conversation. They are not public product tours.
      </p>
      <div class="action-row">
        <a class="button" href={withBase('/works/')}>Case studies</a>
        <a class="text-link" href={withBase('/Tien-Nguyen-CV.pdf')}>Resume PDF</a>
      </div>
    </div>
  </section>
</BaseLayout>
