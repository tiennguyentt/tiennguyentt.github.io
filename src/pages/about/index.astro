---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';
---

<BaseLayout
  title="About"
  description="Tien Nguyen — AI Product Manager and Product Owner. Ex-full-stack engineer in Ho Chi Minh City. Public demos under Gelato; employer facts stay resume-safe."
>
  <section class="page-head section">
    <p class="eyebrow">About</p>
    <h1>Product ownership for agentic systems that have to land in real teams.</h1>
    <p class="lead">
      I am an AI-native Product Manager and Product Owner (she/her) with years across regulated
      insurance, payments, fintech, Web3, e-commerce, ERP, and mobility — and a full-stack
      engineering background that keeps specs honest.
    </p>
  </section>

  <section class="section prose-grid">
    <div>
      <p class="eyebrow">Profile</p>
      <h2>From ambiguous direction to adopted production.</h2>
    </div>
    <div class="prose-stack">
      <p>
        I take AI initiatives from vague intent to governed delivery: source-traced specs, human
        sign-off on every diff, and ownership of the handoff to engineering. Models advise; code,
        policy, and accountable humans decide.
      </p>
      <p>
        Public product work on this site is framed as <strong>Gelato</strong> and other personal
        demos (Knowledge Engine, Recon, Sport Quant). Employer platforms that cannot be demoed —
        including prior Colonial Surety insurtech delivery — stay resume-backed only. Green SM /
        GSM (Vingroup) platform internals stay off this site.
      </p>
    </div>
  </section>

  <section class="section" aria-label="Career ledger">
    <div class="about-ledger">
      <article>
        <span>01</span>
        <h3>Employment</h3>
        <p>
          Green SM / GSM (Vingroup) — platform ops connecting Green SM ecosystems (food, driver, and
          related surfaces). Colonial Surety — prior Product Management Engineer (insurtech / B2B
          fintech; resume-backed delivery, no public demo).
        </p>
      </article>
      <article>
        <span>02</span>
        <h3>Earlier background</h3>
        <p>
          Hoookie (Web3/fintech agency), Olmo (social e-commerce, +30% bookings), ERP BA/APM after
          front-end at 4/10 Fire Protection — per resume.
        </p>
      </article>
      <article>
        <span>03</span>
        <h3>Public systems</h3>
        <p>
          Gelato (Agentic Ops demo), Knowledge Engine, Recon, and Sport Quant. Also Petmood (beta)
          and AnDigi (in design) for Vietnam markets.
        </p>
      </article>
    </div>
  </section>

  <section class="section prose-grid about-closing">
    <div>
      <p class="eyebrow">Method</p>
      <h2>Advisory first. Autonomy only with evidence.</h2>
    </div>
    <div class="prose-stack">
      <p>
        The platforms I design start as recommendation surfaces with decision logs, typed tools,
        and blast-radius limits. Automation graduates only after event quality, evaluation, and
        human feedback prove safe.
      </p>
      <div class="action-row">
        <a class="button" href={withBase('/works/')}>Read the case studies</a>
        <a class="text-link" href={withBase('/Tien-Nguyen-CV.pdf')}>Resume PDF</a>
      </div>
    </div>
  </section>
</BaseLayout>
