---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { RESUME_PAGE, RESUME_PDF } from '../../consts';
import { withBase } from '../../lib/url';

const resumePage = withBase(RESUME_PAGE);
const resumePdf = withBase(RESUME_PDF);
---

<BaseLayout
  title="About"
  description="Tien Nguyen works across payments, consumer products, and agentic operations as a product manager and technical product owner."
>
  <section class="page-head section">
    <p class="eyebrow">About</p>
    <h1>Product management across consumer apps, fintech and enterprise AI.</h1>
  </section>

  <section class="section prose-grid">
    <div>
      <h2>How I work</h2>
    </div>
    <div class="prose-stack">
      <p>
        I decide scope against user outcomes, dependencies and release risk, then work with
        engineers through launch. At Olmo, booking and payment changes raised bookings 30%. At
        Colonial Surety, I led a PCI gateway cutover across three live platforms after the previous
        gateway shut down.
      </p>
    </div>
  </section>

  <section class="section prose-grid">
    <div>
      <p class="eyebrow">Present</p>
      <h2>GSM - Green SM (Vingroup)</h2>
    </div>
    <div class="prose-stack">
      <p>
        At{' '}
        <a href="https://www.greensm.com/vn-vi" target="_blank" rel="noopener noreferrer"
          >Green SM</a
        >, a Vingroup company, I lead product work across connected agentic-operations projects:
        shared AI services, agent orchestration and an ops console. The work covers a model gateway
        with fail-closed data classification, RAG and knowledge-graph tools, ReAct agents,
        simulation and replay, and auditable decision logs. Policy checks and human approval gate
        execution.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="resume-timeline">
    <p class="kicker">Resume</p>
    <h2 id="resume-timeline">Career timeline</h2>
    <div class="about-ledger">
      <article>
        <span>Jul 2026-Present</span>
        <h3>GSM - Green SM (Vingroup)</h3>
        <p>
          I lead product work across shared AI services, agent orchestration and operator workflows
          for enterprise operations.
        </p>
      </article>
      <article>
        <span>Feb 2026-Jul 2026</span>
        <h3>Colonial Surety</h3>
        <p>
          I managed product scope and launch risk for a PCI gateway cutover across three live
          platforms. I also designed one application flow for seven insurance products.
        </p>
      </article>
      <article>
        <span>2019-2026</span>
        <h3>Hoookie, Olmo, ERP</h3>
        <p>
          I shipped aVault and aLink at Hoookie. At Olmo, booking and payment changes raised
          bookings 30%. I started in ERP engineering at 4/10.
        </p>
      </article>
    </div>
  </section>

  <section class="section prose-grid about-closing">
    <div>
      <p class="eyebrow">Next</p>
      <h2>See the work</h2>
    </div>
    <div class="prose-stack">
      <div class="action-row">
        <a class="button" href={withBase('/works/')}>View work</a>
        <a class="text-link" href={resumePage}>View resume</a>
        <a class="text-link" href={resumePdf} data-astro-reload download="Tien-Nguyen-CV.pdf"
          >Download PDF</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
