---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';
---

<BaseLayout
  title="About"
  description="Tien Nguyen leads R&D for agentic ops platforms. AI product manager and product owner in Ho Chi Minh City."
>
  <section class="page-head section">
    <p class="eyebrow">About</p>
    <h1>Agentic ops platforms</h1>
    <p class="lead">
      I lead the R&amp;D team that builds them. I work as AI product manager and product owner in Ho
      Chi Minh City.
    </p>
  </section>

  <section class="section prose-grid">
    <div>
      <p class="eyebrow">How I run it</p>
      <h2>One operating loop</h2>
    </div>
    <div class="prose-stack">
      <p>
        Observe → Detect → Explain → Recommend → Approve → Execute → Verify → Learn. Knowledge,
        orchestration, evaluation, and governance stay on that chain instead of sitting in separate
        tools.
      </p>
      <p>
        Day to day I work in RAG, ReAct agents, and multi-agent orchestration. Human-in-the-loop
        workflows, persistent memory, runtime controls, and evidence-based verification stay on the
        same chain.
      </p>
    </div>
  </section>

  <section class="section prose-grid">
    <div>
      <p class="eyebrow">Now</p>
      <h2>Green SM (Vingroup), R&amp;D</h2>
    </div>
    <div class="prose-stack">
      <p>
        I lead the R&amp;D team that builds agentic ops platforms at{' '}
        <a href="https://www.greensm.com/vn-vi" target="_blank" rel="noopener noreferrer"
          >Green SM</a
        >, also called GSM, a Vingroup company. Title and dates are on the resume. Internals stay
        off this site.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="resume-timeline">
    <p class="kicker">Resume</p>
    <h2 id="resume-timeline">Resume timeline</h2>
    <p class="lead narrow">Same employers and facts as the PDF.</p>
    <div class="about-ledger">
      <article>
        <span>Now</span>
        <h3>Green SM (Vingroup)</h3>
        <p>R&amp;D, agentic ops platforms. Title and dates on the resume.</p>
      </article>
      <article>
        <span>Prior</span>
        <h3>Colonial Surety</h3>
        <p>
          Insurtech and B2B fintech delivery: PM controls, PCI gateway cutover, seven-product
          bundling, B2B SSO scoping.
        </p>
      </article>
      <article>
        <span>Earlier</span>
        <h3>Hoookie, Olmo, ERP</h3>
        <p>Hoookie (Keeta, Sire.bot), Olmo (+30% bookings), and a 4/10 ERP path.</p>
      </article>
    </div>
  </section>

  <section class="section prose-grid about-closing">
    <div>
      <p class="eyebrow">Next</p>
      <h2>Start with the live systems.</h2>
    </div>
    <div class="prose-stack">
      <p>
        Gelato, then Knowledge Engine, Recon, and Sport Quant. Green SM and Colonial stay on this timeline
        and the PDF. They are not public product tours.
      </p>
      <div class="action-row">
        <a class="button" href={withBase('/works/')}>Use cases</a>
        <a class="text-link" href={withBase('/Tien-Nguyen-CV.pdf')}>Resume PDF</a>
      </div>
    </div>
  </section>
</BaseLayout>
