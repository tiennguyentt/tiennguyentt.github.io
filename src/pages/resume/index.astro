---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { RESUME_PDF } from '../../consts';
import { withBase } from '../../lib/url';

const pdfHref = withBase(RESUME_PDF);
---

<BaseLayout
  title="Resume"
  description="Tien Nguyen — AI Product Manager. Applied AI Enterprise. R&D for Agentic Ops Platforms."
>
  <section class="page-head section resume-actions">
    <p class="eyebrow">Resume</p>
    <h1>Tien Nguyen</h1>
    <p class="lead">AI Product Manager · Product Owner · Applied AI Enterprise</p>
    <div class="action-row">
      <a class="button" href={pdfHref} data-astro-reload download="Tien-Nguyen-CV.pdf"
        >Download PDF</a
      >
      <a
        class="button button--ghost"
        href={pdfHref}
        data-astro-reload
        target="_blank"
        rel="noopener noreferrer">Open PDF</a
      >
    </div>
  </section>

  <section class="section resume-sheet" data-pagefind-body>
    <p class="resume-lead">
      I lead the R&amp;D team that builds Agentic Ops Platforms. Source-traced specs, evaluation
      against ground truth, and human approval on critical changes.
    </p>
    <p class="resume-contact">
      <a href="mailto:tiennguyentthao@gmail.com">tiennguyentthao@gmail.com</a>
      <a href="https://www.linkedin.com/in/tiennguyenthithao/">LinkedIn</a>
      <a href="https://tiennguyentt.github.io/">tiennguyentt.github.io</a>
      <span>Ho Chi Minh City</span>
    </p>

    <h2>Experience</h2>
    <article class="resume-job">
      <div class="resume-job__head">
        <h3>Green SM (Vingroup)</h3>
        <span>Now</span>
      </div>
      <p class="resume-job__title">R&amp;D · Agentic Ops Platforms</p>
      <ul>
        <li>
          Lead the R&amp;D team building agentic ops platforms. Title and dates on request.
          Internals stay confidential.
        </li>
      </ul>
    </article>

    <article class="resume-job">
      <div class="resume-job__head">
        <h3>Colonial Surety</h3>
        <span>Prior</span>
      </div>
      <p class="resume-job__title">
        Product Management Engineer · B2B fintech, insurance, payments
      </p>
      <ul>
        <li>
          Owned controls on the agent-operated PM workflow: transcripts graded for traceability,
          specs linked to source, no diff without sign-off.
        </li>
        <li>
          Ran emergency PCI gateway cutover (Transax → CardPointe) across three production
          platforms.
        </li>
        <li>
          Designed seven insurance products in one flow: knockout rules, unified claims, edit policy
          matrix, partial-failure cases.
        </li>
        <li>
          Scoped B2B SSO into a structured BRD: two user types, adaptive registration, cross-partner
          sessions.
        </li>
      </ul>
    </article>

    <article class="resume-job">
      <div class="resume-job__head">
        <h3>Hoookie JSC</h3>
        <span>2023 – 2025</span>
      </div>
      <p class="resume-job__title">
        Product Owner · Web3, fintech · forward-deployed client services
      </p>
      <ul>
        <li>
          Defined requirements for Keeta (US payments network targeting 400 ms): use cases, data
          flows, acceptance criteria.
        </li>
        <li>
          Built Sire.bot with 137% cumulative return in a two-month backtest; scored predictions
          against ground truth before release.
        </li>
        <li>
          Forward-deployed discovery for US and international clients from Vietnam: BRDs, SRS,
          acceptance criteria before handoff.
        </li>
      </ul>
    </article>

    <article class="resume-job">
      <div class="resume-job__head">
        <h3>Olmo Technology</h3>
        <span>2022 – 2023</span>
      </div>
      <p class="resume-job__title">Product Owner · social e-commerce</p>
      <ul>
        <li>+30% bookings after reworking mobile booking and bank-transfer flow.</li>
        <li>Shipped livestream commerce end to end: chat, marketplace, community feed, gifting.</li>
      </ul>
    </article>

    <article class="resume-job">
      <div class="resume-job__head">
        <h3>4/10 Fire Protection Trading Service</h3>
        <span>2019 – 2022</span>
      </div>
      <p class="resume-job__title">Front-end Developer → BA / Associate PM · ERP</p>
      <ul>
        <li>
          Built ERP modules from code to rollout; owned resource-management and quality-control
          paths.
        </li>
      </ul>
    </article>

    <h2>Public systems</h2>
    <div class="resume-grid">
      <p>
        <strong>Gelato</strong>
        Agentic ops route ledger: orchestration, gates, decision logs. In progress.
      </p>
      <p>
        <strong>Knowledge Engine</strong>
        Source-traced wiki, conflict resolution, graded specs, human sign-off.
      </p>
      <p>
        <strong>Recon</strong>
        Daily agent sweeps with relevance, credibility, and predictive weight.
      </p>
      <p>
        <strong>Sport Quant</strong>
        Governed +EV terminal: Elo / Dixon-Coles, fractional Kelly, hard caps.
      </p>
    </div>

    <h2>Skills</h2>
    <dl class="resume-skills">
      <dt>Discovery</dt>
      <dd>Onsite workshops, scope, stakeholder mapping, competitor and domain research</dd>
      <dt>Delivery</dt>
      <dd>Pilot design, integration, production rollout, adoption tracking, Scrum</dd>
      <dt>Requirements</dt>
      <dd>BRD / SRS / PRD, stories, acceptance criteria, failure paths</dd>
      <dt>AI controls</dt>
      <dd>Context engineering, evaluation thresholds, source tracing, human gates</dd>
      <dt>Ops</dt>
      <dd>Agent workflows, MCP, APIs and data flows, model selection</dd>
    </dl>

    <h2>Education</h2>
    <p class="resume-edu">
      <span>Anthropic: Claude Code 101, AI Fluency, Agent Skills, Subagents</span><span>2026</span>
    </p>
    <p class="resume-edu">
      <span>Product School: Launches, Roadmap, Prioritization, Strategy, Discovery, AI Product</span
      ><span>2025</span>
    </p>
    <p class="resume-edu">
      <span>CoderSchool: Full Stack Software Developer</span><span>2019</span>
    </p>
    <p class="resume-edu">
      <span>HCMC University of Education: BA in English</span><span>2014</span>
    </p>
  </section>
</BaseLayout>

<style>
  .resume-actions .action-row {
    margin-top: 1.25rem;
  }

  .resume-sheet {
    max-width: 44rem;
  }

  .resume-lead {
    margin: 0 0 0.85rem;
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .resume-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin: 0 0 1.75rem;
    padding-bottom: 1rem;
    border-bottom: var(--hairline);
    color: var(--color-muted);
    font-size: 0.88rem;
  }

  .resume-sheet h2 {
    margin: 1.6rem 0 0.75rem;
    color: var(--color-muted);
    font-size: 0.78rem;
    font-weight: 560;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .resume-job {
    margin: 0 0 1.15rem;
  }

  .resume-job__head {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: baseline;
  }

  .resume-job__head h3 {
    margin: 0;
    font-size: 1.15rem;
  }

  .resume-job__head span,
  .resume-job__title {
    color: var(--color-muted);
    font-size: 0.88rem;
  }

  .resume-job__title {
    margin: 0.2rem 0 0.4rem;
  }

  .resume-job ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--color-muted);
  }

  .resume-job li {
    margin: 0.25rem 0;
  }

  .resume-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem 1.25rem;
  }

  .resume-grid p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .resume-grid strong {
    display: block;
    margin-bottom: 0.15rem;
    color: var(--color-text);
  }

  .resume-skills {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 0.45rem 0.85rem;
    margin: 0;
  }

  .resume-skills dt {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.85rem;
    font-weight: 560;
  }

  .resume-skills dd {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .resume-edu {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0.35rem 0;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .resume-edu span:last-child {
    white-space: nowrap;
  }

  @media (max-width: 700px) {
    .resume-grid,
    .resume-skills {
      grid-template-columns: 1fr;
    }
  }
</style>
