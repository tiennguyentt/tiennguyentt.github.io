---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { RESUME_PDF } from '../../consts';
import { withBase } from '../../lib/url';

const pdfHref = withBase(RESUME_PDF);
---

<BaseLayout title="Resume" description="Tien Nguyen — R&D Lead PO. Agentic operations platforms.">
  <section class="page-head section resume-actions">
    <p class="eyebrow">Resume</p>
    <h1>Tien Nguyen</h1>
    <p class="lead">R&amp;D Lead PO</p>
    <div class="action-row">
      <a class="button" href={pdfHref} data-astro-reload download="Tien-Nguyen-CV.pdf"
        >Download PDF</a
      >
      <a
        class="button button--ghost"
        href={pdfHref}
        data-astro-reload
        target="_blank"
        rel="noopener noreferrer">Open PDF</a
      >
    </div>
  </section>

  <section class="section resume-sheet" data-pagefind-body>
    <p class="resume-contact">
      Ho Chi Minh City ·
      <a href="mailto:tiennguyentthao@gmail.com">tiennguyentthao@gmail.com</a>
      ·
      <a href="https://www.linkedin.com/in/tiennguyenthithao/">LinkedIn</a>
      ·
      <a href="https://portfolio-tienntt.vercel.app/">portfolio-tienntt.vercel.app</a>
    </p>

    <h2>Summary</h2>
    <p class="resume-lead">
      R&amp;D Lead PO for agentic operations platforms. Agents draft the first pass. I check each
      claim against a source, score output against known facts, and sign off before release.
    </p>

    <h2>Experience</h2>
    <article class="resume-job">
      <h3>Green SM (Vingroup) — R&amp;D Lead PO</h3>
      <p class="resume-job__meta">Agentic Ops Platforms · Ho Chi Minh City · 2025–Present</p>
      <ul>
        <li>
          Lead R&amp;D as product owner for agentic operations platforms. Employer product names and
          internal architecture stay confidential.
        </li>
      </ul>
    </article>

    <article class="resume-job">
      <h3>Colonial Surety — Product Management Engineer</h3>
      <p class="resume-job__meta">B2B fintech, insurance, payments · 2024–2025</p>
      <ul>
        <li>
          Ran a PM workflow with agents: graded transcripts, linked specs to sources, and blocked
          changes that lacked sign-off.
        </li>
        <li>
          Led an emergency PCI payment cutover from Transax to CardPointe across three live
          platforms.
        </li>
        <li>
          Designed seven insurance products in one flow, including knockout rules, shared claims,
          and partial-failure cases. Wrote the B2B SSO brief for two user types and partner
          sessions.
        </li>
      </ul>
    </article>

    <article class="resume-job">
      <h3>Hoookie JSC — Product Owner</h3>
      <p class="resume-job__meta">Web3 and fintech · 2023–2025</p>
      <ul>
        <li>
          Wrote requirements for Keeta, a US payments network targeting 400 ms settlement: use
          cases, data flows, and acceptance checks.
        </li>
        <li>
          Built Sire.bot. A two-month backtest returned 137%. Scored model output against known
          results before release.
        </li>
      </ul>
    </article>

    <article class="resume-job">
      <h3>Olmo Technology — Product Owner</h3>
      <p class="resume-job__meta">Social e-commerce · 2022–2023</p>
      <ul>
        <li>
          Raised bookings 30% by fixing the mobile booking path and bank-transfer flow. Shipped
          livestream commerce with chat, marketplace, and gifting.
        </li>
      </ul>
    </article>

    <article class="resume-job">
      <h3>4/10 Fire Protection Trading Service — Front-end Developer, then BA and Associate PM</h3>
      <p class="resume-job__meta">ERP · 2019–2022</p>
      <ul>
        <li>
          Built ERP modules from code through rollout. Owned resource management and quality
          control.
        </li>
      </ul>
    </article>

    <h2>Projects</h2>
    <ul class="resume-demos">
      <li>
        <strong>Gelato.</strong> Framework that connects agent tools for company operations: orchestration,
        gates, and decision logs. In progress.
      </li>
      <li>
        <strong>Knowledge Engine.</strong> Turns meeting notes into a wiki with sources, flags conflicts,
        and grades specs. Requires human sign-off before engineering starts.
      </li>
      <li>
        <strong>Recon.</strong> Daily research sweeps that score each source for relevance, credibility,
        and predictive weight.
      </li>
      <li>
        <strong>Sport Quant.</strong> Betting terminal with hard risk caps. Models advise; code sets the
        size.
      </li>
    </ul>

    <h2>Skills</h2>
    <ul class="resume-skills-list">
      <li><strong>Discovery:</strong> workshops, scope, stakeholders, competitor research</li>
      <li><strong>Delivery:</strong> pilots, integrations, production rollout, Scrum</li>
      <li><strong>Requirements:</strong> BRD, SRS, PRD, stories, acceptance checks</li>
      <li><strong>AI controls:</strong> source links, eval thresholds, human sign-off</li>
      <li><strong>Operations:</strong> agent workflows, MCP, APIs, model choice</li>
    </ul>

    <h2>Education</h2>
    <ul class="resume-skills-list">
      <li>Anthropic Claude Code and Agent Skills — 2026</li>
      <li>Product School AI Product Certification — 2025</li>
      <li>CoderSchool Full Stack Developer — 2019</li>
      <li>HCMC University of Education, BA English — 2014</li>
    </ul>
  </section>
</BaseLayout>

<style>
  .resume-actions .action-row {
    margin-top: 1.25rem;
  }

  .resume-sheet {
    max-width: 40rem;
  }

  .resume-contact {
    margin: 0 0 1.25rem;
    padding-bottom: 0.85rem;
    border-bottom: var(--hairline);
    color: var(--color-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .resume-lead {
    margin: 0 0 0.5rem;
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.5;
  }

  .resume-sheet h2 {
    margin: 1.5rem 0 0.65rem;
    color: var(--color-text);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-transform: none;
  }

  .resume-job {
    margin: 0 0 1.1rem;
  }

  .resume-job h3 {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 600;
  }

  .resume-job__meta {
    margin: 0.15rem 0 0.35rem;
    color: var(--color-muted);
    font-size: 0.88rem;
  }

  .resume-job ul,
  .resume-demos,
  .resume-skills-list {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--color-muted);
  }

  .resume-job li,
  .resume-demos li,
  .resume-skills-list li {
    margin: 0.25rem 0;
    line-height: 1.45;
  }

  .resume-demos strong,
  .resume-skills-list strong {
    color: var(--color-text);
  }
</style>
