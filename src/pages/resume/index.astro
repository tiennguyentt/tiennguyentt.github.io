---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { RESUME_PDF } from '../../consts';
import { withBase } from '../../lib/url';

const pdfHref = withBase(RESUME_PDF);
---

<BaseLayout
  title="Resume"
  description="Tien Nguyen — AI Product Manager. Applied AI Enterprise. R&D for Agentic Ops Platforms."
>
  <section class="page-head section resume-actions">
    <p class="eyebrow">Resume</p>
    <h1>Tien Nguyen</h1>
    <p class="lead">AI Product Manager · Product Owner · Applied AI Enterprise</p>
    <div class="action-row">
      <a class="button" href={pdfHref} data-astro-reload download="Tien-Nguyen-CV.pdf"
        >Download PDF</a
      >
      <a
        class="button button--ghost"
        href={pdfHref}
        data-astro-reload
        target="_blank"
        rel="noopener noreferrer">Open PDF</a
      >
    </div>
  </section>

  <section class="section resume-sheet" data-pagefind-body>
    <p class="resume-lead">
      I lead the R&amp;D team that builds Agentic Ops Platforms for Applied AI Enterprise work.
      Agents draft. I link every claim to a source, check results against known facts, and sign off
      before anything ships.
    </p>
    <p class="resume-contact">
      <a href="mailto:tiennguyentthao@gmail.com">tiennguyentthao@gmail.com</a>
      <a href="https://www.linkedin.com/in/tiennguyenthithao/">LinkedIn</a>
      <a href="https://portfolio-tienntt.vercel.app/">portfolio-tienntt.vercel.app</a>
      <a href="https://tiennguyentt.github.io/">tiennguyentt.github.io</a>
      <span>Ho Chi Minh City</span>
    </p>

    <h2>Experience</h2>
    <article class="resume-job">
      <div class="resume-job__head">
        <h3>Green SM (Vingroup)</h3>
        <span>Now</span>
      </div>
      <p class="resume-job__title">R&amp;D lead · Agentic Ops Platforms</p>
      <ul>
        <li>
          Lead the R&amp;D team that designs and builds agentic ops platforms. Employer product
          names and internal architecture stay off this page.
        </li>
      </ul>
    </article>

    <article class="resume-job">
      <div class="resume-job__head">
        <h3>Colonial Surety</h3>
        <span>Prior</span>
      </div>
      <p class="resume-job__title">
        Product Management Engineer · B2B fintech, insurance, payments
      </p>
      <ul>
        <li>
          Ran a PM workflow with agents. I graded transcripts, linked specs to sources, and blocked
          any change that lacked my sign-off.
        </li>
        <li>
          Led an emergency PCI payment cutover from Transax to CardPointe across three live
          platforms.
        </li>
        <li>
          Designed seven insurance products in one flow, including knockout rules, shared claims,
          and partial-failure cases. Wrote the B2B SSO brief for two user types and partner
          sessions.
        </li>
      </ul>
    </article>

    <article class="resume-job">
      <div class="resume-job__head">
        <h3>Hoookie JSC</h3>
        <span>2023–2025</span>
      </div>
      <p class="resume-job__title">Product Owner · Web3 and fintech, on-site with clients</p>
      <ul>
        <li>
          Wrote requirements for Keeta, a US payments network aimed at 400 ms settlement. Covered
          use cases, data flows, and acceptance checks.
        </li>
        <li>
          Built Sire.bot. A two-month backtest returned 137%. I scored model output against known
          results before release.
        </li>
      </ul>
    </article>

    <article class="resume-job">
      <div class="resume-job__head">
        <h3>Olmo Technology</h3>
        <span>2022–2023</span>
      </div>
      <p class="resume-job__title">Product Owner · social e-commerce</p>
      <ul>
        <li>
          Raised bookings 30% by fixing the mobile booking path and bank-transfer flow. Shipped
          livestream commerce with chat, marketplace, and gifting.
        </li>
      </ul>
    </article>

    <article class="resume-job">
      <div class="resume-job__head">
        <h3>4/10 Fire Protection Trading Service</h3>
        <span>2019–2022</span>
      </div>
      <p class="resume-job__title">Front-end developer, then BA and associate PM · ERP</p>
      <ul>
        <li>
          Built ERP modules from code through rollout. Owned resource management and quality
          control.
        </li>
      </ul>
    </article>

    <h2>Public demos</h2>
    <div class="resume-grid">
      <p>
        <strong>Gelato.</strong>
        Framework that connects agent tools for company ops. Orchestration, gates, and decision
        logs. In progress.
      </p>
      <p>
        <strong>Knowledge Engine.</strong>
        Turns meeting notes into a wiki with sources. Flags conflicts. Grades specs. Needs my
        sign-off before engineering starts.
      </p>
      <p>
        <strong>Recon.</strong>
        Daily research sweeps. Scores each source for relevance, credibility, and predictive weight.
      </p>
      <p>
        <strong>Sport Quant.</strong>
        Betting terminal with hard risk caps. Models advise. Code decides the size.
      </p>
    </div>

    <h2>Skills</h2>
    <dl class="resume-skills">
      <dt>Discovery</dt>
      <dd>Workshops, scope, stakeholders, competitor research</dd>
      <dt>Delivery</dt>
      <dd>Pilots, integrations, production rollout, Scrum</dd>
      <dt>Requirements</dt>
      <dd>BRD, SRS, PRD, stories, acceptance checks</dd>
      <dt>AI controls</dt>
      <dd>Source links, eval thresholds, human sign-off</dd>
      <dt>Ops</dt>
      <dd>Agent workflows, MCP, APIs, model choice</dd>
    </dl>

    <h2>Education</h2>
    <p class="resume-edu">
      <span>Anthropic Claude Code and Agent Skills</span><span>2026</span>
    </p>
    <p class="resume-edu">
      <span>Product School AI Product Certification</span><span>2025</span>
    </p>
    <p class="resume-edu">
      <span>CoderSchool Full Stack Developer</span><span>2019</span>
    </p>
    <p class="resume-edu">
      <span>HCMC University of Education, BA English</span><span>2014</span>
    </p>
  </section>
</BaseLayout>

<style>
  .resume-actions .action-row {
    margin-top: 1.25rem;
  }

  .resume-sheet {
    max-width: 44rem;
  }

  .resume-lead {
    margin: 0 0 0.85rem;
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .resume-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin: 0 0 1.75rem;
    padding-bottom: 1rem;
    border-bottom: var(--hairline);
    color: var(--color-muted);
    font-size: 0.88rem;
  }

  .resume-sheet h2 {
    margin: 1.6rem 0 0.75rem;
    color: var(--color-muted);
    font-size: 0.78rem;
    font-weight: 560;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .resume-job {
    margin: 0 0 1.15rem;
  }

  .resume-job__head {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: baseline;
  }

  .resume-job__head h3 {
    margin: 0;
    font-size: 1.15rem;
  }

  .resume-job__head span,
  .resume-job__title {
    color: var(--color-muted);
    font-size: 0.88rem;
  }

  .resume-job__title {
    margin: 0.2rem 0 0.4rem;
  }

  .resume-job ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--color-muted);
  }

  .resume-job li {
    margin: 0.25rem 0;
  }

  .resume-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem 1.25rem;
  }

  .resume-grid p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .resume-grid strong {
    display: inline;
    margin-right: 0.15rem;
    color: var(--color-text);
  }

  .resume-skills {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 0.45rem 0.85rem;
    margin: 0;
  }

  .resume-skills dt {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.85rem;
    font-weight: 560;
  }

  .resume-skills dd {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .resume-edu {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0.35rem 0;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .resume-edu span:last-child {
    white-space: nowrap;
  }

  @media (max-width: 700px) {
    .resume-grid,
    .resume-skills {
      grid-template-columns: 1fr;
    }
  }
</style>
