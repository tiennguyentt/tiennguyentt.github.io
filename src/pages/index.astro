---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import ProductScene from '../components/ProductScene.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import { SITE } from '../consts';
import { t } from '../i18n';

const works = (await getCollection('works')).sort((a, b) => {
  const byOrder = (a.data.order ?? 999) - (b.data.order ?? 999);
  return byOrder || b.data.publishDate.getTime() - a.data.publishDate.getTime();
});

const live = works.filter((w) => w.data.link);
const gelato = works.find((w) => w.id.startsWith('gelato'));

const demos = [
  ...live.map((work) => {
    const kind = work.id.includes('knowledge')
      ? ('knowledge' as const)
      : work.id.includes('sport')
        ? ('sport' as const)
        : ('recon' as const);
    return {
      kind,
      title: work.data.title,
      href: work.data.link!,
      external: true,
    };
  }),
  ...(gelato
    ? [
        {
          kind: 'gelato' as const,
          title: 'Gelato',
          href: withBase(`/works/${gelato.id}/`),
          external: false,
        },
      ]
    : []),
];

const site = Astro.site ?? new URL(Astro.url.origin);
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Tien Nguyen',
  givenName: 'Tien',
  familyName: 'Nguyen',
  gender: 'Female',
  jobTitle: 'AI Product Manager / Product Owner',
  description: SITE.description,
  url: new URL(withBase('/'), site).href,
  email: 'mailto:tiennguyentthao@gmail.com',
  sameAs: [
    'https://www.linkedin.com/in/tiennguyenthithao/',
    'https://github.com/tiennguyentt',
    'https://x.com/gelato_aop',
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Ho Chi Minh City',
    addressCountry: 'VN',
  },
};
---

<BaseLayout description={SITE.description}>
  <StructuredData slot="head" schema={personSchema} />

  <section class="hero section">
    <p class="kicker">Tien Nguyen · AI Product Manager · HCMC</p>
    <h1>Applied AI for enterprise.</h1>
    <p class="lead">
      I design and lead platforms that turn complex workflows into governed operations.
    </p>
    <div class="action-row" aria-label={t('home.primaryLinks')}>
      <a
        class="button"
        href="https://tienntt-knowledge-engine.streamlit.app/"
        target="_blank"
        rel="noopener noreferrer">Knowledge Engine</a
      >
      <a class="button button--ghost" href={withBase('/works/')}>Use cases</a>
    </div>
  </section>

  <section class="section demos-band" aria-label="Use cases">
    <div class="demo-grid">
      {
        demos.map((demo) => (
          <a
            class={`demo-card demo-card--${demo.kind}`}
            href={demo.href}
            target={demo.external ? '_blank' : undefined}
            rel={demo.external ? 'noopener noreferrer' : undefined}
          >
            <div class="demo-card__visual">
              <ProductScene kind={demo.kind} />
            </div>
            <div class="demo-card__bar">
              <span>{demo.title}</span>
              <span>Explore</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section method-band" aria-label="Method">
    <div class="method-copy">
      <p class="kicker">Method</p>
      <h2>How the platform runs</h2>
      <p class="op-loop" aria-label="Operating loop">
        Observe → Detect → Explain → Recommend → Approve → Execute → Verify → Learn
      </p>
      <p class="lead">Models advise inside the loop. Humans approve before anyone executes.</p>
    </div>
  </section>

  <section class="section contact-band" aria-labelledby="contact-head">
    <p class="kicker">Get started</p>
    <h2 id="contact-head">Open to AI product roles</h2>
    <p class="lead">
      Seven years in B2B fintech, payments, transportation, and enterprise systems. Ho Chi Minh
      City.
    </p>
    <div class="action-row">
      <a class="button" href="mailto:tiennguyentthao@gmail.com">Email</a>
      <a class="button button--ghost" href="https://www.linkedin.com/in/tiennguyenthithao/"
        >LinkedIn</a
      >
    </div>
  </section>
</BaseLayout>
