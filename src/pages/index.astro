---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import DemoGlyph from '../components/DemoGlyph.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import { SITE } from '../consts';
import { t } from '../i18n';

const works = (await getCollection('works')).sort((a, b) => {
  const byOrder = (a.data.order ?? 999) - (b.data.order ?? 999);
  return byOrder || b.data.publishDate.getTime() - a.data.publishDate.getTime();
});

const live = works.filter((w) => w.data.link);
const gelato = works.find((w) => w.id.startsWith('gelato'));

const demos = [
  ...live.map((work) => {
    const kind = work.id.includes('knowledge')
      ? ('knowledge' as const)
      : work.id.includes('sport')
        ? ('sport' as const)
        : ('recon' as const);
    const tone = kind === 'knowledge' ? 'mist' : kind === 'sport' ? 'sage' : 'stone';
    return {
      kind,
      tone,
      title: work.data.title,
      description: work.data.description,
      href: work.data.link!,
      status: 'Live' as const,
      external: true,
    };
  }),
  ...(gelato
    ? [
        {
          kind: 'gelato' as const,
          tone: 'ink' as const,
          title: gelato.data.title,
          description: gelato.data.description,
          href: withBase(`/works/${gelato.id}/`),
          status: 'Scaffold — building' as const,
          external: false,
        },
      ]
    : []),
];

const site = Astro.site ?? new URL(Astro.url.origin);
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Tien Nguyen',
  givenName: 'Tien',
  familyName: 'Nguyen',
  gender: 'Female',
  jobTitle: 'AI Product Manager / Product Owner',
  description: SITE.description,
  url: new URL(withBase('/'), site).href,
  email: 'mailto:tiennguyentthao@gmail.com',
  sameAs: [
    'https://www.linkedin.com/in/tiennguyenthithao/',
    'https://github.com/tiennguyentt',
    'https://x.com/gelato_aop',
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Ho Chi Minh City',
    addressCountry: 'VN',
  },
};
---

<BaseLayout description={SITE.description}>
  <StructuredData slot="head" schema={personSchema} />

  <section class="hero section">
    <p class="kicker">Product · Agents · HCMC</p>
    <h1>Tien Nguyen</h1>
    <p class="hero-line">
      Agentic AI for everything you{' '}
      <span
        class="hero-cycle"
        data-words="ship,evaluate,specify,gate"
        aria-live="polite"
        aria-atomic="true"
      >
        <span class="hero-cycle__track">
          <span class="hero-cycle__word is-active">ship</span>
        </span>
        <span class="hero-cycle__rule" aria-hidden="true"></span>
      </span>.
    </p>
    <p class="lead">
      Source-traced specs. Ground-truth evals. Human sign-off on every critical change.
    </p>
    <div class="action-row" aria-label={t('home.primaryLinks')}>
      <a
        class="button"
        href="https://tienntt-knowledge-engine.streamlit.app/"
        target="_blank"
        rel="noopener noreferrer">Knowledge Engine</a
      >
      <a class="text-link" href={withBase('/works/')}>Work</a>
    </div>
  </section>

  <script>
    function initHeroCycle() {
      const root = document.querySelector<HTMLElement>('.hero-cycle');
      if (!root || root.dataset.bound === '1') return;
      root.dataset.bound = '1';

      const words = (root.dataset.words ?? 'ship')
        .split(',')
        .map((w) => w.trim())
        .filter(Boolean);
      if (words.length < 2) return;

      const track = root.querySelector<HTMLElement>('.hero-cycle__track');
      if (!track) return;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let index = 0;
      let busy = false;

      const measure = (text: string) => {
        const probe = document.createElement('span');
        probe.className = 'hero-cycle__word is-active';
        probe.style.position = 'absolute';
        probe.style.visibility = 'hidden';
        probe.style.pointerEvents = 'none';
        probe.textContent = text;
        track.appendChild(probe);
        const width = probe.getBoundingClientRect().width;
        probe.remove();
        return width;
      };

      const setWidth = (text: string) => {
        track.style.width = `${measure(text)}px`;
      };

      setWidth(words[0]);

      const swap = () => {
        if (busy) return;
        busy = true;
        const next = (index + 1) % words.length;
        const current = track.querySelector<HTMLElement>('.hero-cycle__word.is-active');
        if (!current) {
          busy = false;
          return;
        }

        if (reduceMotion) {
          current.textContent = words[next];
          setWidth(words[next]);
          index = next;
          busy = false;
          return;
        }

        const incoming = document.createElement('span');
        incoming.className = 'hero-cycle__word is-enter';
        incoming.textContent = words[next];
        track.appendChild(incoming);
        setWidth(words[next]);

        requestAnimationFrame(() => {
          current.classList.remove('is-active');
          current.classList.add('is-exit');
          incoming.classList.remove('is-enter');
          incoming.classList.add('is-active');
        });

        window.setTimeout(() => {
          current.remove();
          index = next;
          busy = false;
        }, 520);
      };

      window.setInterval(swap, 2600);
    }

    initHeroCycle();
    document.addEventListener('astro:page-load', initHeroCycle);
  </script>

  <section class="section demos-band" aria-label="Demo use cases">
    <p class="kicker">Use cases</p>
    <h2>Demos and placeholders</h2>
    <p class="lead narrow demos-intro">
      Live systems first. Gelato platforms sit as scaffold until builds ship.
    </p>

    <div class="demo-grid">
      {
        demos.map((demo) => (
          <a
            class={`demo-card demo-card--${demo.tone}`}
            href={demo.href}
            target={demo.external ? '_blank' : undefined}
            rel={demo.external ? 'noopener noreferrer' : undefined}
          >
            <div class="demo-card__visual" aria-hidden="true">
              <span class="demo-card__badge">
                <DemoGlyph kind={demo.kind} />
              </span>
            </div>
            <div class="demo-card__body">
              <p class="demo-card__status">{demo.status}</p>
              <h3>{demo.title}</h3>
              <p>{demo.description}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section method-band" aria-label="Method">
    <p class="kicker">Method</p>
    <h2>Gate what models cannot own.</h2>
    <p class="lead narrow">
      Scope the non-deterministic parts. Trace every claim to a source. Score against ground truth
      before autonomy.
    </p>
  </section>

  <section class="section contact-band" aria-labelledby="contact-head">
    <p class="kicker">Contact</p>
    <h2 id="contact-head">AI-native PM roles</h2>
    <p class="lead narrow">
      Green SM platform ops. Personal demos public. Colonial delivery on the resume only.
    </p>
    <div class="action-row">
      <a class="button" href="mailto:tiennguyentthao@gmail.com">Email</a>
      <a class="text-link" href="https://www.linkedin.com/in/tiennguyenthithao/">LinkedIn</a>
    </div>
  </section>
</BaseLayout>
