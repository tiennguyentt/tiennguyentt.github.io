---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import ProductScene from '../components/ProductScene.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import { RESUME_PAGE, SITE } from '../consts';
import { t } from '../i18n';

const works = (await getCollection('works')).sort((a, b) => {
  const byOrder = (a.data.order ?? 999) - (b.data.order ?? 999);
  return byOrder || b.data.publishDate.getTime() - a.data.publishDate.getTime();
});

const live = works.filter((w) => w.data.link);
const gelato = works.find((w) => w.id.startsWith('gelato'));

const demos = [
  ...live.map((work) => {
    const kind = work.id.includes('knowledge')
      ? ('knowledge' as const)
      : work.id.includes('sport')
        ? ('sport' as const)
        : ('recon' as const);
    return {
      kind,
      title: work.data.title,
      href: work.data.link!,
      external: true,
    };
  }),
  ...(gelato
    ? [
        {
          kind: 'gelato' as const,
          title: 'Gelato',
          href: withBase(`/works/${gelato.id}/`),
          external: false,
        },
      ]
    : []),
];

const site = Astro.site ?? new URL(Astro.url.origin);
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Tien Nguyen',
  givenName: 'Tien',
  familyName: 'Nguyen',
  gender: 'Female',
  jobTitle: 'Product Manager and Technical Product Owner',
  description: SITE.description,
  url: new URL(withBase('/'), site).href,
  email: 'mailto:tiennguyentthao@gmail.com',
  telephone: '+84 963 351 586',
  sameAs: [
    'https://www.linkedin.com/in/tiennguyenthithao/',
    'https://github.com/tiennguyentt',
    'https://x.com/gelato_aop',
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Ho Chi Minh City',
    addressCountry: 'VN',
  },
};
---

<BaseLayout description={SITE.description}>
  <StructuredData slot="head" schema={personSchema} />

  <section class="hero hero--role section">
    <p class="kicker">Tien Nguyen · Product manager · Ho Chi Minh City</p>
    <h1>Product manager across payments, consumer products, and agentic operations.</h1>
    <p class="lead">
      I write requirements and work with engineers through release. At Green SM, I own product
      requirements for agentic operations, where policy checks and human approval gate execution.
    </p>
    <div class="action-row" aria-label={t('home.primaryLinks')}>
      <a class="button" href={withBase(RESUME_PAGE)}>View resume</a>
      <a class="button button--ghost" href={withBase('/works/')}>Selected work</a>
      <a class="text-link" href="https://www.linkedin.com/in/tiennguyenthithao/">LinkedIn</a>
    </div>
    <dl class="proof-row" aria-label="Career highlights">
      <div>
        <dt>+30% bookings</dt>
        <dd>Mobile booking and payment flow at Olmo</dd>
      </div>
      <div>
        <dt>PCI cutover</dt>
        <dd>Transax to CardPointe across three live Colonial platforms</dd>
      </div>
      <div>
        <dt>7 insurance products</dt>
        <dd>Designed one application flow at Colonial Surety</dd>
      </div>
    </dl>
  </section>

  <section class="section demos-band" aria-label="Selected personal work">
    <div class="demos-intro">
      <p class="kicker">Personal work</p>
      <h2>Projects you can open</h2>
      <p class="lead">
        These are public demos and research projects. Employer work is on the resume.
      </p>
    </div>
    <div class="demo-sheet">
      <div class="demo-grid">
        {
          demos.map((demo) => (
            <a
              class={`demo-card demo-card--${demo.kind}`}
              href={demo.href}
              target={demo.external ? '_blank' : undefined}
              rel={demo.external ? 'noopener noreferrer' : undefined}
              aria-label={`${demo.title}. ${demo.external ? 'Open live demo' : 'Read in-progress project'}`}
            >
              <div class="demo-card__visual">
                <ProductScene kind={demo.kind} />
              </div>
              <div class="demo-card__bar">
                <span>{demo.title}</span>
                <span>{demo.external ? 'Open live demo' : 'Read project'}</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section contact-band" aria-labelledby="contact-head">
    <p class="kicker">Contact</p>
    <h2 id="contact-head">Reach Tien</h2>
    <p class="lead">Talk to me about payments, consumer products, or agentic operations.</p>
    <div class="action-row">
      <a class="button" href="mailto:tiennguyentthao@gmail.com">Email</a>
      <a class="button button--ghost" href="https://www.linkedin.com/in/tiennguyenthithao/"
        >LinkedIn</a
      >
      <a class="text-link" href={withBase(RESUME_PAGE)}>View resume</a>
    </div>
  </section>
</BaseLayout>
