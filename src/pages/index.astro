---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import { SITE } from '../consts';
import { formatDate, t } from '../i18n';

const works = (await getCollection('works'))
  .sort((a, b) => {
    const byOrder = (a.data.order ?? 999) - (b.data.order ?? 999);
    return byOrder || b.data.publishDate.getTime() - a.data.publishDate.getTime();
  })
  .slice(0, 3);

const site = Astro.site ?? new URL(Astro.url.origin);
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Tien Nguyen',
  givenName: 'Tien',
  familyName: 'Nguyen',
  gender: 'Female',
  jobTitle: 'AI Product Manager / Product Owner',
  description: SITE.description,
  url: new URL(withBase('/'), site).href,
  email: 'mailto:tiennguyentthao@gmail.com',
  sameAs: [
    'https://www.linkedin.com/in/tiennguyenthithao/',
    'https://github.com/tiennguyentt',
    'https://x.com/gelato_aop',
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Ho Chi Minh City',
    addressCountry: 'VN',
  },
};
---

<BaseLayout description={SITE.description}>
  <StructuredData slot="head" schema={personSchema} />

  <section class="hero section">
    <p class="eyebrow">AI Product Manager · Product Owner · Ho Chi Minh City</p>
    <h1>Tien Nguyen</h1>
    <p class="lead">
      I design and lead enterprise agentic platforms — governed workflows from observe through
      verify and learn. Advisory-first. Human sign-off before anything reaches engineering.
    </p>
    <div class="action-row" aria-label={t('home.primaryLinks')}>
      <a class="button" href={withBase('/works/')}>View case studies</a>
      <a class="text-link" href={withBase('/Tien-Nguyen-CV.pdf')}>Download resume</a>
    </div>
  </section>

  <section class="section split-overview" aria-label="How I work">
    <div>
      <p class="eyebrow">Operating model</p>
      <h2>Ambiguous AI direction becomes buildable, auditable work.</h2>
    </div>
    <div class="feature-list">
      <article>
        <h3>Scope the non-deterministic</h3>
        <p>
          Separate what models may advise from what code and policy must decide. Integration points
          and risk gates come before prompts.
        </p>
      </article>
      <article>
        <h3>Source-traced specs</h3>
        <p>
          Transcripts and notes become a wiki with truth hierarchy, conflict checks, and graded
          handoffs — then a human signs the diff.
        </p>
      </article>
      <article>
        <h3>Adoption, not just launch</h3>
        <p>
          Rollouts in regulated fintech and insurance stay owned through discovery, control, and
          team uptake — not a one-time demo.
        </p>
      </article>
    </div>
  </section>

  <section class="section index-feed" aria-labelledby="latest-works">
    <div class="section-heading">
      <p class="eyebrow">Selected work</p>
      <h2 id="latest-works">Case studies built for interview depth.</h2>
      <a class="text-link" href={withBase('/works/')}>All work</a>
    </div>

    {
      works.length > 0 ? (
        <div class="highlight-grid">
          {works.map((work) => (
            <article class="highlight-card">
              <div>
                <p class="meta">{formatDate(work.data.publishDate, 'short')}</p>
                <h3>
                  <a href={withBase(`/works/${work.id}/`)}>{work.data.title}</a>
                </h3>
                <p>{work.data.description}</p>
                {work.data.tech.length > 0 && (
                  <ul class="tag-list" aria-label={`Stack for ${work.data.title}`}>
                    {work.data.tech.slice(0, 4).map((tech) => (
                      <li>{tech}</li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state compact">
          <p>Case studies are loading into this collection.</p>
        </div>
      )
    }
  </section>

  <section class="section split-overview contact-band" aria-labelledby="contact-head">
    <div>
      <p class="eyebrow">Contact</p>
      <h2 id="contact-head">Open to AI-native PM roles.</h2>
    </div>
    <div class="prose-stack">
      <p>
        Building Gelato and other governed agent demos in public. Day job: platform ops across
        Green SM (Vingroup) ecosystems, plus prior regulated fintech delivery — details on the
        resume. Based in Ho Chi Minh City.
      </p>
      <div class="action-row">
        <a class="button" href="mailto:tiennguyentthao@gmail.com">Email Tien</a>
        <a class="text-link" href="https://www.linkedin.com/in/tiennguyenthithao/">LinkedIn</a>
      </div>
    </div>
  </section>
</BaseLayout>
